<%- include('../partials/head', { pageTitle }) %>
<%- include('../partials/panel-header') %>

    <% if (visao === 'global') { %>

      <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-agro-700">Visão geral da feira</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900">Resumo de tickets</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Total de tickets</p>
            <p class="mt-1 text-2xl font-bold text-slate-900"><%= resumo.total_tickets %></p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Valor total</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">R$ <%= resumo.total_valor.toFixed(2) %></p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Produtores com tickets</p>
            <p class="mt-1 text-2xl font-bold text-slate-900"><%= resumo.produtores_ativos %></p>
          </div>
        </div>
      </section>

      <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-agro-700">Oferta vs. Demanda</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900">Aproveitamento da feira</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Total trazido</p>
            <p class="mt-1 text-2xl font-bold text-slate-900"><%= ofertaDemanda.total_trazido.toFixed(1) %> kg</p>
          </div>
          <div class="rounded-2xl bg-emerald-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-emerald-700">Total comercializado</p>
            <p class="mt-1 text-2xl font-bold text-emerald-700"><%= ofertaDemanda.total_vendido.toFixed(1) %> kg</p>
          </div>
          <div class="rounded-2xl bg-agro-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-agro-700">Taxa de absorção</p>
            <p class="mt-1 text-2xl font-bold text-agro-700"><%= taxaAbsorcao.toFixed(0) %>%</p>
          </div>
        </div>

        <% if (sobrasPorCategoria.length) { %>
          <h4 class="mt-6 text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Sobras por categoria</h4>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase text-slate-400">
                  <th class="py-2">Categoria</th>
                  <th class="py-2 text-right">Trazido</th>
                  <th class="py-2 text-right">Vendido</th>
                  <th class="py-2 text-right">Sobra</th>
                </tr>
              </thead>
              <tbody>
                <% sobrasPorCategoria.forEach((c) => { %>
                  <tr class="border-b border-slate-100">
                    <td class="py-2 font-semibold text-slate-800"><%= c.categoria %></td>
                    <td class="py-2 text-right text-slate-600"><%= c.total_trazido.toFixed(1) %> kg</td>
                    <td class="py-2 text-right text-emerald-700 font-semibold"><%= c.total_vendido.toFixed(1) %> kg</td>
                    <td class="py-2 text-right text-amber-700 font-semibold"><%= c.total_sobra.toFixed(1) %> kg</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="mt-4 text-sm text-slate-400">Nenhum fechamento registrado ainda para calcular sobras.</p>
        <% } %>
      </section>

      <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-agro-700">Pós-feira</p>
        <h3 class="text-xl font-bold text-slate-900">Lançar tickets</h3>
        <p class="mt-2 text-sm text-slate-600">Registre a quantidade de tickets recebidos por cada produtor ao final da feira.</p>

        <form action="/painel/tickets" method="POST" id="formLancarTicket" class="mt-5 grid gap-3 md:grid-cols-[1.2fr_140px_120px_140px_auto]">
          <div class="relative">
            <input type="text" id="produtorNomeInput" placeholder="Digite ou selecione o produtor" required autocomplete="off"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
            <input type="hidden" name="produtor_id" id="produtorIdHidden" />
            <div id="produtorSugestoes" class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-56 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg"></div>
          </div>
          <input type="date" name="data_feira" required class="rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-3 pr-5 text-sm outline-none focus:border-agro-500 focus:bg-white" />
          <input type="number" name="quantidade" min="1" required placeholder="Qtd. tickets" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
          <input type="number" name="valor_unitario" min="0.01" step="0.01" required placeholder="Valor/ticket" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
          <button type="submit" class="rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-agro-700">Lançar</button>
        </form>
      </section>

      <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-xl font-bold text-slate-900">Últimos lançamentos</h3>
          <a href="/painel/relatorio/lixeira" class="inline-flex items-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-rose-400 hover:text-rose-700">
            Lixeira
          </a>
        </div>

        <!-- Filtro simplificado e unificado na ordem desejada -->
<div class="mt-4 flex flex-wrap items-center gap-3" id="seletorPeriodo">

   <!-- 1. Produtor -->
  <div class="relative">
    <input type="text" id="filtroProdutorInput" placeholder="Todos os produtores" autocomplete="off"
      class="w-56 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 outline-none transition focus:border-agro-500 focus:bg-white" />
    <input type="hidden" id="filtroProdutor" value="" />
    <button type="button" id="btnLimparFiltroProdutorInput" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-400 hover:text-rose-600">&times;</button>
    <div id="filtroProdutorSugestoes" class="hidden absolute left-0 right-0 top-full z-30 mt-1 max-h-56 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg"></div>
  </div>
   <!-- 2. Data / Calendário -->
  <div class="relative">
    <button type="button" id="btnAbrirData" class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 outline-none transition hover:border-agro-500">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Escolher datas
    </button>
    <div id="popoverData" class="hidden fixed z-30 w-[min(20rem,92vw)] rounded-2xl border border-slate-200 bg-white p-4 shadow-xl sm:w-80">
      <p class="text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Período</p>

      <button type="button" id="btnAbrirListaDias"
        class="mt-3 flex w-full items-center justify-between rounded-xl border border-agro-200 bg-agro-50 px-3 py-2.5 text-sm font-semibold text-agro-700 transition hover:border-agro-400 hover:bg-agro-100">
        <span>Escolher um dia já lançado</span>
        <span>›</span>
      </button>

      <div class="my-4 flex items-center gap-2">
        <span class="h-px flex-1 bg-slate-100"></span>
        <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">ou manualmente</span>
        <span class="h-px flex-1 bg-slate-100"></span>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-500">De</label>
          <input type="date" id="periodoValorDataInicio" class="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-agro-500 focus:bg-white" />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500">Até</label>
          <input type="date" id="periodoValorDataFim" class="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-agro-500 focus:bg-white" />
        </div>
      </div>
      <p class="mt-1 text-[11px] text-slate-400">Deixe "Até" vazio pra filtrar só 1 dia.</p>

      <div class="mt-4 flex items-center gap-2">
        <button type="button" id="btnLimparDataPopover" class="rounded-xl border border-slate-200 px-3 py-2.5 text-xs font-semibold text-slate-500 transition hover:border-rose-300 hover:text-rose-600">Limpar</button>
        <button type="button" id="btnConfirmarData" class="flex-1 rounded-xl bg-agro-600 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-agro-700">Confirmar</button>
      </div>
    </div>
  </div>

  <!-- Modal: lista de dias já lançados (seleção múltipla) -->
  <div id="modalListaDias" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/60 p-4">
    <div class="flex w-full max-w-md max-h-[80vh] flex-col rounded-3xl bg-white p-6 shadow-2xl sm:max-w-lg">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-slate-900">Dias com lançamento</h3>
        <button type="button" id="btnFecharListaDias" class="flex h-9 w-9 items-center justify-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-700">✕</button>
      </div>

      <input type="text" id="buscaListaDias" placeholder="Buscar dia (ex: 03/08/2026)" autocomplete="off"
        class="mt-4 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />

      <label class="mt-3 flex items-center gap-2 text-xs font-semibold text-slate-500 select-none cursor-pointer">
        <input type="checkbox" id="marcarTodosDias" class="h-4 w-4 rounded border-slate-300 text-agro-600" />
        Selecionar todos os dias visíveis
      </label>

      <div id="listaDiasCadastrados" class="mt-3 flex-1 space-y-1.5 overflow-y-auto pr-1 scroll-fino"></div>
      <p id="listaDiasVazia" class="hidden mt-2 text-center text-sm text-slate-400">Nenhum dia encontrado.</p>

      <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <p class="text-xs font-semibold text-agro-700" id="contadorDiasSelecionados"></p>
        <div class="flex items-center gap-3">
          <button type="button" id="btnCancelarListaDias" class="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
          <button type="button" id="btnConfirmarListaDias" class="rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white hover:bg-agro-700">Confirmar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Resumo da seleção ativa -->
  <span id="periodoResumoTexto" class="text-xs font-semibold text-agro-700">Mostrando tudo</span>

   <!-- 3. Gerar PDF/Relatório (abre direto o modal usando o filtro atual) -->
   <button type="button" id="btnAbrirRelatorio" class="rounded-2xl bg-agro-600 px-4 py-2 text-xs font-bold text-white transition hover:bg-agro-700">
    📄 Gerar Relatório
  </button>

  <span class="mx-1 h-5 w-px bg-slate-200"></span>

     <!-- 4. Limpar Filtro -->
  <button type="button" id="btnLimparPeriodo" class="text-xs font-semibold text-slate-500 underline hover:text-rose-600">Limpar Filtro</button>

  </div>

        <form action="/painel/tickets/excluir-lote" method="POST" id="formExcluirLote" class="select-none">
          <div id="inputsSelecionados"></div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-600 select-none cursor-pointer">
              <input type="checkbox" id="marcarTodos" class="h-4 w-4 rounded border-slate-300 text-agro-600" />
              Selecionar todos
            </label>
            <p class="text-xs text-slate-400">Clique para selecionar · botão direito abre o menu · Delete exclui</p>
            <button type="submit" id="btnExcluirLote" style="display: none;"
              class="inline-flex items-center gap-2 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
              Excluir selecionados (<span id="contadorSelecionados">0</span>)
            </button>
          </div>

          <div class="mt-3 max-h-[420px] space-y-1 overflow-y-auto pr-1 select-none scroll-fino" id="listaLancamentos"></div>
          <div id="listaLancamentosVazia" class="mt-5 hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">Nenhum lançamento encontrado para esse período.</div>
        </form>
      </section>

      <!-- PAGAMENTOS + COMPARATIVO -->
      <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <h3 class="text-xl font-bold text-slate-900">Pagamentos e comparativo por produtor</h3>

        <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:divide-x lg:divide-slate-100">
          <div class="lg:pr-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h4 class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Pagamentos aos produtores</h4>
              <div class="flex gap-2 rounded-2xl bg-slate-100 p-1">
                <button type="button" id="tabPagAPagar" class="pag-tab-btn rounded-xl px-4 py-2 text-sm font-semibold transition">A pagar</button>
                <button type="button" id="tabPagPagos" class="pag-tab-btn rounded-xl px-4 py-2 text-sm font-semibold transition">Pagos</button>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
              <label class="flex items-center gap-2 text-sm font-semibold text-slate-600 select-none cursor-pointer">
                <input type="checkbox" id="marcarTodosPag" class="h-4 w-4 rounded border-slate-300 text-agro-600" />
                Selecionar todos
              </label>
              <p class="text-xs text-slate-400">Clique para selecionar · botão direito abre o menu</p>
              <button type="button" id="btnAcaoLotePag" style="display: none;"
                class="inline-flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100">
                Marcar como pago (<span id="contadorSelecionadosPag">0</span>)
              </button>
            </div>

            <div class="mt-3 max-h-[300px] space-y-2 overflow-y-auto pr-1 scroll-fino" id="listaPagamentos"></div>
            <div id="listaPagamentosVazia" class="mt-5 hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">Nada por aqui para esse período.</div>

            <form id="formMarcarPago" action="/painel/tickets/marcar-pago" method="POST" class="hidden"></form>
            <form id="formDesmarcarPago" action="/painel/tickets/desmarcar-pago" method="POST" class="hidden"></form>
          </div>

          <div class="lg:pl-8 self-start" id="colunaGrafico">
            <h4 class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Comparativo por produtor</h4>
            <p class="mt-1 text-xs text-slate-400" id="comparativoSubtitulo">Mostrando "a pagar", no período selecionado ao lado.</p>
            <div class="mt-4 overflow-x-auto pb-2 grafico-scroll" id="graficoScrollBox">
              <div id="graficoComparativoWrapper">
                <canvas id="graficoComparativo" height="300"></canvas>
              </div>
            </div>
            <div id="semDadosGrafico" class="mt-4 hidden rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
              Nenhum ticket lançado nesse período ainda.
            </div>
          </div>
        </div>
      </section>

    <% } else { %>

      <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-agro-700">Meu relatório</p>
        <h2 class="mt-1 text-2xl font-bold text-slate-900">Tickets recebidos</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500">Total de tickets</p>
            <p class="mt-1 text-2xl font-bold text-slate-900"><%= resumo.total_tickets %></p>
          </div>
          <div class="rounded-2xl bg-amber-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-amber-700">Valor a receber</p>
            <p class="mt-1 text-2xl font-bold text-amber-700">R$ <%= resumo.valor_pendente.toFixed(2) %></p>
          </div>
          <div class="rounded-2xl bg-emerald-50 p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-emerald-700">Já recebido</p>
            <p class="mt-1 text-2xl font-bold text-emerald-700">R$ <%= resumo.total_pago.toFixed(2) %></p>
          </div>
        </div>
      </section>

      <section class="mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
        <h3 class="text-xl font-bold text-slate-900">Meus lançamentos</h3>
        <p class="mt-1 text-sm text-slate-500">Aqui aparecem todos os tickets que a gestora lançou no seu nome. Filtre por período para achar um dia específico.</p>

        <div class="mt-4 flex flex-wrap items-center gap-3" id="meuSeletorPeriodo">
          <div class="relative">
            <button type="button" id="meuBtnAbrirData" class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 outline-none transition hover:border-agro-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Escolher datas
            </button>
            <div id="meuPopoverData" class="hidden fixed z-30 w-[min(20rem,92vw)] rounded-2xl border border-slate-200 bg-white p-4 shadow-xl sm:w-80">
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">Período</p>

              <button type="button" id="meuBtnAbrirListaDias"
                class="mt-3 flex w-full items-center justify-between rounded-xl border border-agro-200 bg-agro-50 px-3 py-2.5 text-sm font-semibold text-agro-700 transition hover:border-agro-400 hover:bg-agro-100">
                <span>📋 Escolher um dia já lançado</span>
                <span>›</span>
              </button>

              <div class="my-4 flex items-center gap-2">
                <span class="h-px flex-1 bg-slate-100"></span>
                <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">ou manualmente</span>
                <span class="h-px flex-1 bg-slate-100"></span>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-slate-500">De</label>
                  <input type="date" id="meuFiltroDataInicio" class="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-agro-500 focus:bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-500">Até</label>
                  <input type="date" id="meuFiltroDataFim" class="mt-1 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm outline-none focus:border-agro-500 focus:bg-white" />
                </div>
              </div>
              <p class="mt-1 text-[11px] text-slate-400">Deixe "Até" vazio pra filtrar só 1 dia.</p>

              <div class="mt-4 flex items-center gap-2">
                <button type="button" id="meuBtnLimparDataPopover" class="rounded-xl border border-slate-200 px-3 py-2.5 text-xs font-semibold text-slate-500 transition hover:border-rose-300 hover:text-rose-600">Limpar</button>
                <button type="button" id="meuBtnConfirmarData" class="flex-1 rounded-xl bg-agro-600 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-agro-700">Confirmar</button>
              </div>
            </div>
          </div>

          <span id="meuPeriodoResumoTexto" class="text-xs font-semibold text-agro-700">Mostrando tudo</span>

          <button type="button" id="btnMeuLimparFiltro" class="text-xs font-semibold text-slate-500 underline hover:text-rose-600">Limpar Filtro</button>
        </div>

        <!-- Modal: lista de dias já lançados (produtor) -->
        <div id="modalMeuListaDias" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/60 p-4">

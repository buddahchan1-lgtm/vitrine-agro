  function textoResumoDias(dias) {
    if (dias.length <= 2) return dias.map(formatarData).join(', ');
    return `${dias.length} dias selecionados`;
  }

  function calcularIntervalo() {
    if (diasSelecionados.length) {
      const dias = diasSelecionados.slice().sort();
      return { dias, texto: textoResumoDias(dias) };
    }

    const de = inputDataInicio.value;
    const ate = inputDataFim.value;
    if (!de && !ate) return null;

    // Se só um dos dois estiver preenchido, usa ele pros dois lados (filtra 1 dia só)
    let inicio = de || ate;
    let fim = ate || de;
    if (inicio > fim) [inicio, fim] = [fim, inicio];

    const texto = inicio === fim
      ? formatarData(inicio)
      : `${formatarData(inicio)} → ${formatarData(fim)}`;

    return { inicio, fim, texto };
  }

  function disparar() {
    const intervalo = calcularIntervalo();
    const partes = [];
    if (produtorId) {
      const p = listaProdutores.find((x) => String(x.id) === String(produtorId));
      if (p) partes.push(p.nome);
    }
    if (intervalo) partes.push(intervalo.texto);
    resumoTexto.textContent = partes.length ? partes.join(' · ') : 'Mostrando tudo';
    listeners.forEach((fn) => fn(intervalo, produtorId));
  }


        gruposAtuais.forEach((g) => {
          const row = document.createElement('div');
          row.className = 'pagamento-row flex cursor-pointer items-center gap-3 rounded-2xl border border-transparent bg-slate-50 px-4 py-3.5 transition hover:border-agro-200 hover:bg-white hover:shadow-sm';
          row.dataset.grupoId = g.chave;
          const iniciais = g.produtor_nome.trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
          row.innerHTML = `
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-agro-100 text-sm font-bold text-agro-700">${iniciais}</span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-semibold text-slate-900">${g.produtor_nome}</span>
              <span class="block text-xs text-slate-500">${g.total_tickets} tickets · ${formatarData(g.data_feira)}</span>
            </span>
            <span class="font-bold text-agro-700">R$ ${g.total_valor.toFixed(2)}</span>
          `;
          listaEl.appendChild(row);
        });
      }
      atualizarUISelecao();
      renderGrafico();
    }

    listaEl.addEventListener('click', (e) => {
      const row = e.target.closest('.pagamento-row');
      if (!row) return;
      ativarPainel('pagamentos');
      const id = row.dataset.grupoId;
      if (selecionados.has(id)) selecionados.delete(id);
      else selecionados.add(id);
      atualizarUISelecao();
    });

    listaEl.addEventListener('contextmenu', (e) => {
      const row = e.target.closest('.pagamento-row');
      if (!row) return;
      e.preventDefault();
      const id = row.dataset.grupoId;
      if (!selecionados.has(id)) {
        selecionados.clear();
        selecionados.add(id);
        atualizarUISelecao();
      }
      btnMarcarPago.style.display = abaAtual === 'a_pagar' ? 'block' : 'none';
      btnVoltarAPagar.style.display = abaAtual === 'pagos' ? 'block' : 'none';
      menu.style.left = e.clientX + 'px';
      menu.style.top = e.clientY + 'px';
      menu.classList.remove('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target)) menu.classList.add('hidden');
    });

    function idsSelecionados() {
      return gruposAtuais.filter((g) => selecionados.has(g.chave)).flatMap((g) => g.ids);
    }

    btnMarcarPago.addEventListener('click', () => {
      menu.classList.add('hidden');
      const ids = idsSelecionados();
      if (!ids.length) return;
      confirmarAcao(`Marcar ${selecionados.size} produtor(es) como pago?`, () => {
        submeterForm(formMarcar, ids);
      });
    });

    btnVoltarAPagar.addEventListener('click', () => {
      menu.classList.add('hidden');
      const ids = idsSelecionados();
      if (!ids.length) return;
      confirmarAcao(`Voltar ${selecionados.size} produtor(es) para "a pagar"?`, () => {
        submeterForm(formDesmarcar, ids);
      });
    });

    tabAPagar.addEventListener('click', () => { abaAtual = 'a_pagar'; renderPagamentos(); });
    tabPagos.addEventListener('click', () => { abaAtual = 'pagos'; renderPagamentos(); });

    if (marcarTodosPag) {
      marcarTodosPag.addEventListener('change', () => {
        ativarPainel('pagamentos');
        if (marcarTodosPag.checked) gruposAtuais.forEach((g) => selecionados.add(g.chave));
        else selecionados.clear();
        atualizarUISelecao();
      });
    }

    if (btnAcaoLotePag) {
      btnAcaoLotePag.addEventListener('click', () => {
        const ids = idsSelecionados();
        if (!ids.length) return;
        const mensagem = abaAtual === 'a_pagar'
          ? `Marcar ${selecionados.size} produtor(es) como pago?`
          : `Voltar ${selecionados.size} produtor(es) para "a pagar"?`;
        confirmarAcao(mensagem, () => {
          submeterForm(abaAtual === 'a_pagar' ? formMarcar : formDesmarcar, ids);
        });
      });
    }

    function renderGrafico() {
      if (!ctx) return;
      const grupos = gruposAtuais;

      if (!grupos.length) {
        ctx.classList.add('hidden');
        semDados.classList.remove('hidden');
        if (chart) chart.destroy();
        return;
      }
      ctx.classList.remove('hidden');
      semDados.classList.add('hidden');

      if (chart) chart.destroy();

      const wrapper = document.getElementById('graficoComparativoWrapper');
      const scrollBox = document.getElementById('graficoScrollBox') || wrapper.parentElement;
      const coluna = document.getElementById('colunaGrafico');
      const larguraDisponivel = Math.floor(coluna.clientWidth - 32);

      const BARRAS_IDEAIS = 5;
      const LARGURA_MINIMA_BARRA = 90;
      const larguraPorBarraIdeal = larguraDisponivel / Math.min(grupos.length, BARRAS_IDEAIS);
      const larguraPorBarra = Math.max(larguraPorBarraIdeal, LARGURA_MINIMA_BARRA);

      const barrasVisiveis = Math.max(1, Math.min(grupos.length, Math.floor(larguraDisponivel / larguraPorBarra)));
      const larguraJanela = Math.round(barrasVisiveis * larguraPorBarra);
      const larguraTotal = Math.round(larguraPorBarra * grupos.length);
      const precisaRolar = grupos.length > barrasVisiveis;

      scrollBox.style.width = larguraJanela + 'px';
      scrollBox.style.overflowX = 'auto';
      scrollBox.scrollLeft = 0;
      coluna.classList.toggle('tem-scroll', precisaRolar);
      wrapper.style.width = larguraTotal + 'px';
      wrapper.style.height = '300px';
      ctx.style.width = '100%';
      ctx.style.height = '100%';

      const ehPagos = abaAtual === 'pagos';
      const alturaCanvas = ctx.height || 220;
      const gradiente = ctx.getContext('2d').createLinearGradient(0, 0, 0, alturaCanvas);
      if (ehPagos) {
        gradiente.addColorStop(0, '#fb923c');
        gradiente.addColorStop(1, '#c2410c');
      } else {
        gradiente.addColorStop(0, '#22c55e');
        gradiente.addColorStop(1, '#15803d');
      }

      const mesmoProdutorApareceMaisDeUmaVez = new Set(grupos.map((g) => g.produtor_id)).size < grupos.length;

      chart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: grupos.map((g) => mesmoProdutorApareceMaisDeUmaVez ? [g.produtor_nome, formatarData(g.data_feira)] : [g.produtor_nome]),
          datasets: [{
            label: 'Valor total (R$)',
            data: grupos.map((g) => g.total_valor),
            backgroundColor: gradiente,
            hoverBackgroundColor: ehPagos ? '#9a3412' : '#166534',
            borderRadius: 10,
            maxBarThickness: 64,
            borderWidth: 0,
            hoverBorderWidth: 3,
            hoverBorderColor: ehPagos ? '#7c2d12' : '#052e16'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          devicePixelRatio: Math.max(window.devicePixelRatio || 1, 2),
          resizeDelay: 0,
          interaction: { mode: 'index', intersect: false, axis: 'x' },
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: 'index',
              intersect: false,
              backgroundColor: '#ffffff',
              titleColor: ehPagos ? '#9a3412' : '#166534',
              bodyColor: ehPagos ? '#c2410c' : '#15803d',
              borderColor: ehPagos ? '#fed7aa' : '#bbf7d0',
              borderWidth: 1,
              padding: 12,
              displayColors: false,
              titleFont: { weight: 'bold', size: 13 },
              bodyFont: { weight: 'bold', size: 13 },
              callbacks: {
                title: (itens) => {
                  const g = grupos[itens[0].dataIndex];
                  return `${g.produtor_nome} · ${formatarData(g.data_feira)}`;
                },
                label: (contexto) => {
                  const g = grupos[contexto.dataIndex];
                  return [`R$ ${g.total_valor.toFixed(2)}`, `${g.total_tickets} tickets`];
                }
              }
            }
          },
          scales: {
            y: { beginAtZero: true, grace: '15%', grid: { color: '#f1f5f9' } },
            x: { grid: { display: false }, ticks: { autoSkip: false, maxRotation: 0, minRotation: 0 } }
          }
        }
      });
    }

    seletorPeriodo.onChange((intervalo, produtorId) => {
      intervaloAtual = intervalo;
      produtorAtual = produtorId;
      renderPagamentos();
    });

    renderPagamentos();
  })();

    // RELATÓRIO — usa o mesmo filtro (produtor + data) já selecionado em "Últimos lançamentos"
  (function () {
    const btnAbrir = document.getElementById('btnAbrirRelatorio');
    const btnPdf = document.getElementById('btnBaixarPdfDia');
    const btnFechar = document.getElementById('btnFecharRelatorioDia');
    const modal = document.getElementById('modalRelatorioDia');
    const documento = document.getElementById('relatorioDiaDocumento');
    const dataTexto = document.getElementById('relatorioDiaDataTexto');
    const lista = document.getElementById('relatorioDiaLista');
    const totalTicketsEl = document.getElementById('relatorioDiaTotalTickets');
    const totalValorEl = document.getElementById('relatorioDiaTotalValor');
    if (!documento || !btnAbrir) return;

     const tabTickets = document.getElementById('tabRelatorioTickets');
    const tabVolume = document.getElementById('tabRelatorioVolume');
    const wrapTickets = document.getElementById('relatorioTicketsWrap');
    const wrapVolume = document.getElementById('relatorioVolumeWrap');
    const volumeDocumento = document.getElementById('relatorioVolumeDocumento');

    function ativarAbaRelatorio(aba) {
      const ehVolume = aba === 'volume';
      wrapTickets.classList.toggle('hidden', ehVolume);
      wrapVolume.classList.toggle('hidden', !ehVolume);
      [tabTickets, tabVolume].forEach((b) => {
        const ativo = (b === tabVolume) === ehVolume;
        b.classList.toggle('bg-white', ativo);
        b.classList.toggle('shadow-sm', ativo);
        b.classList.toggle('text-agro-700', ativo);
        b.classList.toggle('text-slate-500', !ativo);
      });
    }
    tabTickets.addEventListener('click', () => ativarAbaRelatorio('tickets'));
    tabVolume.addEventListener('click', () => ativarAbaRelatorio('volume'));
    ativarAbaRelatorio('tickets');

    function gerarTickets() {
      const intervalo = filtroAtual.intervalo;
      const produtorId = filtroAtual.produtorId;

      const doPeriodo = filtrarPorProdutor(filtrarPorIntervalo(ticketsCompletos, intervalo), produtorId);

      if (!doPeriodo.length) {
        dataTexto.textContent = intervalo ? intervalo.texto : 'Todos os períodos';
        lista.innerHTML = '<p class="py-4 text-center text-sm text-slate-400">Nenhum ticket lançado nesse período/produtor.</p>';
        totalTicketsEl.textContent = '0';
        totalValorEl.textContent = 'R$ 0.00';
        return;
      }

      const porProdutor = {};
      doPeriodo.forEach((t) => {
        if (!porProdutor[t.produtor_id]) {
          porProdutor[t.produtor_id] = { nome: t.produtor_nome, tickets: 0, valor: 0 };
        }
        porProdutor[t.produtor_id].tickets += t.quantidade;
        porProdutor[t.produtor_id].valor += t.quantidade * t.valor_unitario;
      });

      const linhas = Object.values(porProdutor).sort((a, b) => a.nome.localeCompare(b.nome));
      const totalTickets = linhas.reduce((soma, l) => soma + l.tickets, 0);
      const totalValor = linhas.reduce((soma, l) => soma + l.valor, 0);

      dataTexto.textContent = intervalo ? intervalo.texto : 'Todos os períodos';
      lista.innerHTML = linhas.map((l) => `
        <div class="flex items-center w-full py-2 border-b border-slate-100">
          <span class="w-[50%] text-left font-semibold text-slate-900">${l.nome}</span>
          <span class="w-[20%] text-right text-slate-600">${l.tickets}</span>
          <span class="w-[30%] text-right font-semibold text-agro-700">R$ ${l.valor.toFixed(2)}</span>
        </div>
      `).join('');
      totalTicketsEl.textContent = totalTickets;
      totalValorEl.textContent = 'R$ ' + totalValor.toFixed(2);
    }

    function gerarVolume() {
      const linhas = volumePorProdutor || [];
      const totalLevado = linhas.reduce((s, l) => s + Number(l.total_trazido || 0), 0);
      const totalVendido = linhas.reduce((s, l) => s + Number(l.total_vendido || 0), 0);
      const totalSobra = linhas.reduce((s, l) => s + Number(l.total_sobra || 0), 0);

      const listaVolumeEl = document.getElementById('relatorioVolumeLista');
      if (!linhas.length) {
        listaVolumeEl.innerHTML = '<p class="py-4 text-center text-sm text-slate-400">Nenhum volume registrado ainda.</p>';
      } else {
        listaVolumeEl.innerHTML = linhas.map((l) => `
          <div class="flex items-center w-full py-2 border-b border-slate-100">
            <span class="w-[34%] text-left font-semibold text-slate-900">${l.produtor_nome}</span>
            <span class="w-[22%] text-right text-slate-600">${Number(l.total_trazido).toFixed(1)} kg</span>
            <span class="w-[22%] text-right text-emerald-700 font-semibold">${Number(l.total_vendido).toFixed(1)} kg</span>
            <span class="w-[22%] text-right text-amber-700 font-semibold">${Number(l.total_sobra).toFixed(1)} kg</span>
          </div>
        `).join('');
      }
      document.getElementById('relatorioVolumeTotalLevado').textContent = totalLevado.toFixed(1) + ' kg';
      document.getElementById('relatorioVolumeTotalVendido').textContent = totalVendido.toFixed(1) + ' kg';
      document.getElementById('relatorioVolumeTotalSobra').textContent = totalSobra.toFixed(1) + ' kg';
    }

    btnAbrir.addEventListener('click', () => {
      gerarTickets();
      gerarVolume();
      ativarAbaRelatorio('tickets');
      modal.classList.remove('hidden');
    });

    btnFechar.addEventListener('click', () => {
      modal.classList.add('hidden');
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    btnPdf.addEventListener('click', () => {
      window.scrollTo(0, 0);
      const alvo = wrapVolume.classList.contains('hidden') ? documento : volumeDocumento;
      html2pdf().set({
  margin: 10,
  filename: 'relatorio-' + (filtroAtual.intervalo ? filtroAtual.intervalo.inicio : 'geral') + '.pdf',
  html2canvas: {
    scale: 2,
    useCORS: true,
    scrollY: 0,
    scrollX: 0
  },
  pagebreak: { mode: ['avoid-all', 'css', 'legacy'] },
  jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
}).from(alvo).save();
    });
  })();
  
</script>

<!-- Lista de tickets do próprio produtor (visão individual), com filtro por período -->
<script>
  (function () {
    const listaEl = document.getElementById('listaMeusLancamentos');
    const vaziaEl = document.getElementById('listaMeusLancamentosVazia');
    if (!listaEl) return; // essa seção só existe na visão do produtor

    const inputInicio = document.getElementById('meuFiltroDataInicio');
    const inputFim = document.getElementById('meuFiltroDataFim');
    const btnLimpar = document.getElementById('btnMeuLimparFiltro');
    const resumoTexto = document.getElementById('meuPeriodoResumoTexto');

    const btnAbrirData = document.getElementById('meuBtnAbrirData');
    const popoverData = document.getElementById('meuPopoverData');
    const btnConfirmarData = document.getElementById('meuBtnConfirmarData');
    const btnLimparPopover = document.getElementById('meuBtnLimparDataPopover');
    const btnAbrirListaDias = document.getElementById('meuBtnAbrirListaDias');

    const modalListaDias = document.getElementById('modalMeuListaDias');
    const buscaListaDias = document.getElementById('meuBuscaListaDias');
    const listaDiasCadastrados = document.getElementById('meuListaDiasCadastrados');
    const listaDiasVazia = document.getElementById('meuListaDiasVazia');
    const btnFecharListaDias = document.getElementById('meuBtnFecharListaDias');
    const btnCancelarListaDias = document.getElementById('meuBtnCancelarListaDias');

    const todosTickets = (typeof ticketsCompletos !== 'undefined' ? ticketsCompletos : [])
      .slice()
      .sort((a, b) => new Date(b.criado_em || b.data_feira) - new Date(a.criado_em || a.data_feira));

    function formatarDataLocal(d) {
      return new Date(d + 'T00:00:00').toLocaleDateString('pt-BR');
    }

   function atualizarResumoTexto() {
      if (diasSelecionadosAtuais.length) {
        const dias = diasSelecionadosAtuais.slice().sort();
        resumoTexto.textContent = dias.length <= 2
          ? dias.map(formatarDataLocal).join(', ')
          : `${dias.length} dias selecionados`;
        return;
      }
      const de = inputInicio.value;
      const ate = inputFim.value;
      if (!de && !ate) {
        resumoTexto.textContent = 'Mostrando tudo';
        return;
      }
      resumoTexto.textContent = (de === ate || !ate)
        ? formatarDataLocal(de || ate)
        : `${formatarDataLocal(de)} → ${formatarDataLocal(ate)}`;
    }

    function renderLista() {
      const de = inputInicio.value;
      const ate = inputFim.value;

      const filtrados = todosTickets.filter((t) => {
        if (diasSelecionadosAtuais.length) return diasSelecionadosAtuais.includes(t.data_feira);
        if (de && t.data_feira < de) return false;
        if (ate && t.data_feira > ate) return false;
        return true;
      });

      listaEl.innerHTML = '';
      if (!filtrados.length) {
        vaziaEl.classList.remove('hidden');
        return;
      }
      vaziaEl.classList.add('hidden');

      filtrados.forEach((t) => {
        const row = document.createElement('div');
        row.className = 'flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3';
        row.innerHTML = `
          <span class="flex-1 text-sm font-semibold text-slate-900">${formatarDataLocal(t.data_feira)}</span>
          <span class="text-sm font-medium text-slate-700">${t.quantidade} tickets</span>
          <span class="font-bold text-agro-700">R$ ${(t.quantidade * t.valor_unitario).toFixed(2)}</span>
          ${t.pago_em
            ? '<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Pago</span>'
            : '<span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">A pagar</span>'}
        `;
        listaEl.appendChild(row);
      });
    }

    function aplicarFiltro() {
      atualizarResumoTexto();
      renderLista();
    }

     btnLimpar.addEventListener('click', () => {
      inputInicio.value = '';
      inputFim.value = '';
      diasSelecionadosAtuais = [];
      aplicarFiltro();
    });

    [inputInicio, inputFim].forEach((input) => {
      input.addEventListener('input', () => {
        diasSelecionadosAtuais = [];
      });
    });

    // ---- Popover "Escolher datas" ----
    if (btnAbrirData && popoverData) {
      btnAbrirData.addEventListener('click', (e) => {
        e.stopPropagation();
        const abrindo = popoverData.classList.contains('hidden');
        if (abrindo) posicionarPopoverAncorado(btnAbrirData, popoverData);
        popoverData.classList.toggle('hidden');
      });
      window.addEventListener('resize', () => {
        if (!popoverData.classList.contains('hidden')) posicionarPopoverAncorado(btnAbrirData, popoverData);
      });
      window.addEventListener('scroll', () => {
        if (!popoverData.classList.contains('hidden')) posicionarPopoverAncorado(btnAbrirData, popoverData);
      }, true);
      document.addEventListener('click', (e) => {
        if (!popoverData.contains(e.target) && e.target !== btnAbrirData) {
          popoverData.classList.add('hidden');
        }
      });

      if (btnConfirmarData) {
        btnConfirmarData.addEventListener('click', () => {
          aplicarFiltro();
          popoverData.classList.add('hidden');
        });
      }
      if (btnLimparPopover) {
        btnLimparPopover.addEventListener('click', () => {
          inputInicio.value = '';
          inputFim.value = '';
          aplicarFiltro();
          popoverData.classList.add('hidden');
        });
      }
    }

    // ---- Modal "Escolher um dia já lançado" (seleção múltipla) ----
    let diasSelecionadosAtuais = [];

    if (modalListaDias) {
      const datasUnicas = [...new Set(todosTickets.map((t) => t.data_feira))].sort().reverse();
      const marcarTodosDias = document.getElementById('meuMarcarTodosDias');
      const contadorDiasSelecionados = document.getElementById('meuContadorDiasSelecionados');
      const btnConfirmarListaDias = document.getElementById('meuBtnConfirmarListaDias');

      const diasPendentes = new Set();
      let ultimasFiltradas = [];

      function atualizarContador() {
        contadorDiasSelecionados.textContent = diasPendentes.size
          ? `${diasPendentes.size} dia(s) selecionado(s)`
          : '';
        if (marcarTodosDias) {
          marcarTodosDias.checked = ultimasFiltradas.length > 0 && ultimasFiltradas.every((d) => diasPendentes.has(d));
        }
      }

      function renderListaDias(termo) {
        const termoLimpo = (termo || '').trim().toLowerCase();
        const filtradas = termoLimpo ? datasUnicas.filter((d) => formatarDataLocal(d).includes(termoLimpo)) : datasUnicas;
        ultimasFiltradas = filtradas;

        listaDiasCadastrados.innerHTML = '';
        listaDiasVazia.classList.toggle('hidden', filtradas.length > 0);

        filtradas.forEach((data) => {
          const marcado = diasPendentes.has(data);
          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'flex w-full items-center gap-3 rounded-2xl border px-4 py-3 text-left text-sm font-semibold transition ' +
            (marcado ? 'border-agro-600 bg-agro-600 text-white' : 'border-slate-200 bg-slate-50 text-slate-700 hover:border-agro-500 hover:bg-white');
          item.innerHTML = `
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-md border ${marcado ? 'border-white bg-white text-agro-600' : 'border-slate-300 bg-white text-transparent'}">✓</span>
            <span>📅 ${formatarDataLocal(data)}</span>
          `;
          item.addEventListener('click', () => {
            if (diasPendentes.has(data)) diasPendentes.delete(data);
            else diasPendentes.add(data);
            renderListaDias(buscaListaDias.value);
          });
          listaDiasCadastrados.appendChild(item);
        });

        atualizarContador();
      }

      function abrirModalListaDias() {
        if (popoverData) popoverData.classList.add('hidden');
        diasPendentes.clear();
        diasSelecionadosAtuais.forEach((d) => diasPendentes.add(d));
        buscaListaDias.value = '';
        renderListaDias('');
        modalListaDias.classList.remove('hidden');
      }
      function fecharModalListaDias() {
        modalListaDias.classList.add('hidden');
      }

      if (btnAbrirListaDias) {
        if (!datasUnicas.length) {
          btnAbrirListaDias.disabled = true;
          btnAbrirListaDias.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          btnAbrirListaDias.addEventListener('click', abrirModalListaDias);
        }
      }

      buscaListaDias.addEventListener('input', () => renderListaDias(buscaListaDias.value));
      btnFecharListaDias.addEventListener('click', fecharModalListaDias);
      btnCancelarListaDias.addEventListener('click', fecharModalListaDias);

      if (marcarTodosDias) {
        marcarTodosDias.addEventListener('change', () => {
          if (marcarTodosDias.checked) ultimasFiltradas.forEach((d) => diasPendentes.add(d));
          else ultimasFiltradas.forEach((d) => diasPendentes.delete(d));
          renderListaDias(buscaListaDias.value);
        });
      }

      modalListaDias.addEventListener('click', (e) => {
        if (e.target === modalListaDias) fecharModalListaDias();
      });

      btnConfirmarListaDias.addEventListener('click', () => {
        diasSelecionadosAtuais = [...diasPendentes];
        inputInicio.value = '';
        inputFim.value = '';
        aplicarFiltro();
        fecharModalListaDias();
        if (popoverData) popoverData.classList.add('hidden');
      });
    }

    aplicarFiltro();
  })();
</script>

   .scroll-fino { scrollbar-width: auto; scrollbar-color: #4ade80 #ecfdf5; }
  .scroll-fino::-webkit-scrollbar { width: 10px; }
  .scroll-fino::-webkit-scrollbar-track { background: #ecfdf5; border-radius: 999px; }
  .scroll-fino::-webkit-scrollbar-thumb { background-color: #4ade80; border-radius: 999px; border: 2px solid #ecfdf5; }
  .scroll-fino::-webkit-scrollbar-thumb:hover { background-color: #16a34a; }

  .arrastar-vertical { cursor: grab; }
  .arrastar-vertical.arrastando-vertical { cursor: grabbing; user-select: none; }


    if (hiddenFiltroProdutor) hiddenFiltroProdutor.value = '';
    if (btnLimparFiltroProdutorInput) btnLimparFiltroProdutorInput.classList.add('hidden');
    produtorId = '';
    disparar();
  });

  return {
    onChange: (fn) => listeners.push(fn),
    aplicarData: disparar,
    aplicarDiasSelecionados: (dias) => {
      diasSelecionados = dias.slice();
      inputDataInicio.value = '';
      inputDataFim.value = '';
      disparar();
    },
    diasSelecionadosAtuais: () => diasSelecionados.slice()
  };

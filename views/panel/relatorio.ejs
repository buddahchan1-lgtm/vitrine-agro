<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
  const listaProdutores = <%- JSON.stringify(produtores || []) %>;
  const ticketsCompletos = <%- JSON.stringify(ticketsCompletos || []) %>;
  const volumePorProdutor = <%- JSON.stringify(volumePorProdutor || []) %>;

  const NOMES_MESES = {
    '01': 'Janeiro', '02': 'Fevereiro', '03': 'Março', '04': 'Abril',
    '05': 'Maio', '06': 'Junho', '07': 'Julho', '08': 'Agosto',
    '09': 'Setembro', '10': 'Outubro', '11': 'Novembro', '12': 'Dezembro'
  };

   function formatarData(d) {
    return new Date(d + 'T00:00:00').toLocaleDateString('pt-BR');
  }

  // Posiciona um popover "fixed" colado no botão que o abriu, sempre
  // dentro dos limites da tela — reaproveitado pelos dois seletores
  // de data desta página (gestora e produtor).
  function posicionarPopoverAncorado(botao, painel) {
    const rectBtn = botao.getBoundingClientRect();

    painel.style.visibility = 'hidden';
    painel.classList.remove('hidden');
    const largura = painel.offsetWidth;
    const altura = painel.offsetHeight;
    painel.classList.add('hidden');
    painel.style.visibility = '';

    let left = rectBtn.left;
    if (left + largura > window.innerWidth - 12) left = window.innerWidth - largura - 12;
    if (left < 12) left = 12;

    let top = rectBtn.bottom + 8;
    if (top + altura > window.innerHeight - 12) top = rectBtn.top - altura - 8;
    if (top < 12) top = 12;

    painel.style.left = left + 'px';
    painel.style.top = top + 'px';
  }


   function confirmarAcao(mensagem, aoConfirmar) {
    const modal = document.getElementById('modalConfirmarAcao');
    const texto = document.getElementById('confirmarAcaoTexto');
    const btnOk = document.getElementById('btnConfirmarAcaoOk');
    const btnCancelar = document.getElementById('btnConfirmarAcaoCancelar');
    if (!modal) { aoConfirmar(); return; }

    texto.textContent = mensagem;
    modal.classList.remove('hidden');

    function limpar() {
      modal.classList.add('hidden');
      btnOk.removeEventListener('click', onOk);
      btnCancelar.removeEventListener('click', onCancelar);
    }
    function onOk() { limpar(); aoConfirmar(); }
    function onCancelar() { limpar(); }

    btnOk.addEventListener('click', onOk);
    btnCancelar.addEventListener('click', onCancelar);
  }

 function avisar(mensagem) {
    const modal = document.getElementById('modalAviso');
    const texto = document.getElementById('avisoTexto');
    const btnOk = document.getElementById('btnAvisoOk');
    if (!modal) { alert(mensagem); return; }

    texto.textContent = mensagem;
    modal.classList.remove('hidden');

    function onOk() {
      modal.classList.add('hidden');
      btnOk.removeEventListener('click', onOk);
    }
    btnOk.addEventListener('click', onOk);
  }

  const formTicket = document.getElementById('formLancarTicket');
  if (formTicket) {
    const inputNome = document.getElementById('produtorNomeInput');
    const inputIdHidden = document.getElementById('produtorIdHidden');
    const caixaSugestoes = document.getElementById('produtorSugestoes');

    function renderSugestoes(lista) {
      caixaSugestoes.innerHTML = '';
      if (!lista.length) {
        caixaSugestoes.classList.add('hidden');
        return;
      }
      lista.forEach((p) => {
        const item = document.createElement('div');
        item.textContent = p.nome;
        item.className = 'cursor-pointer px-4 py-3 text-sm text-slate-700 hover:bg-agro-50 hover:text-agro-700';
        item.addEventListener('mousedown', (e) => {
          e.preventDefault();
          inputNome.value = p.nome;
          inputIdHidden.value = p.id;
          caixaSugestoes.classList.add('hidden');
        });
        caixaSugestoes.appendChild(item);
      });
      caixaSugestoes.classList.remove('hidden');
    }

     inputNome.addEventListener('focus', () => {
      const termo = inputNome.value.trim().toLowerCase();
      if (termo) renderSugestoes(listaProdutores.filter((p) => p.nome.toLowerCase().includes(termo)));
    });

    inputNome.addEventListener('input', () => {
      inputIdHidden.value = '';
      const termo = inputNome.value.trim().toLowerCase();
      if (!termo) {
        caixaSugestoes.classList.add('hidden');
        return;
      }
      renderSugestoes(listaProdutores.filter((p) => p.nome.toLowerCase().includes(termo)));
    });

    inputNome.addEventListener('blur', () => {
      setTimeout(() => caixaSugestoes.classList.add('hidden'), 100);
    });

    formTicket.addEventListener('submit', function (e) {
      // Se o produtor já foi escolhido clicando na sugestão, o ID já está
      // salvo aqui — não precisamos (e não devemos) tentar re-achar pelo
      // texto digitado, porque pequenas diferenças (espaço, acento,
      // maiúscula/minúscula) no nome cadastrado quebravam essa comparação
      // e bloqueavam o envio mesmo com o produtor certo selecionado.
      if (inputIdHidden.value) {
        return;
      }

      const digitado = inputNome.value.trim().toLowerCase();
      const match = listaProdutores.find(p => p.nome.trim().toLowerCase() === digitado);
      if (!match) {
        e.preventDefault();
        avisar('Selecione um produtor válido da lista de sugestões.');
        return;
      }
      inputIdHidden.value = match.id;
    });
  }

  function popularSelectAnos(select, anos, valorSalvo) {
    select.innerHTML = '<option value="">Todos os anos</option>';
    anos.forEach((ano) => {
      const opt = document.createElement('option');
      opt.value = ano;
      opt.textContent = ano;
      select.appendChild(opt);
    });
    if (valorSalvo && anos.includes(valorSalvo)) select.value = valorSalvo;
  }

  function popularSelectMeses(select, meses, valorSalvo) {
    select.innerHTML = '<option value="">Todos os meses</option>';
    meses.forEach((mes) => {
      const opt = document.createElement('option');
      opt.value = mes;
      opt.textContent = NOMES_MESES[mes] || mes;
      select.appendChild(opt);
    });
    if (valorSalvo && meses.includes(valorSalvo)) select.value = valorSalvo;
  }

  function popularSelectSemanas(select, semanas, valorSalvo) {
    select.innerHTML = '<option value="">Todas as semanas</option>';
    semanas.forEach((semana) => {
      const opt = document.createElement('option');
      opt.value = semana;
      opt.textContent = 'Semana ' + Number(semana);
      select.appendChild(opt);
    });
    if (valorSalvo && semanas.includes(valorSalvo)) select.value = valorSalvo;
  }

  function anosDisponiveis(lista) {
    return [...new Set(lista.map((t) => t.ano))].sort().reverse();
  }
  function mesesDisponiveis(lista, ano) {
    const filtrado = ano ? lista.filter((t) => t.ano === ano) : lista;
    return [...new Set(filtrado.map((t) => t.mes))].sort();
  }
  function semanasDisponiveis(lista, ano, mes) {
    let filtrado = lista;
    if (ano) filtrado = filtrado.filter((t) => t.ano === ano);
    if (mes) filtrado = filtrado.filter((t) => t.mes === mes);
    return [...new Set(filtrado.map((t) => t.semana))].sort((a, b) => Number(a) - Number(b));
  }

  function filtrarPorPeriodo(lista, filtro) {
    return lista.filter((t) => {
      if (filtro.ano && t.ano !== filtro.ano) return false;
      if (filtro.mes && t.mes !== filtro.mes) return false;
      if (filtro.semana && t.semana !== filtro.semana) return false;
      return true;
    });
  }

  const selecaoPainel = { ativo: null, limpar: {} };
  function ativarPainel(nome) {
    if (selecaoPainel.ativo && selecaoPainel.ativo !== nome && selecaoPainel.limpar[selecaoPainel.ativo]) {
      selecaoPainel.limpar[selecaoPainel.ativo]();
    }
    selecaoPainel.ativo = nome;
  }

   const seletorPeriodo = (function () {
  const inputDataInicio = document.getElementById('periodoValorDataInicio');
  const inputDataFim = document.getElementById('periodoValorDataFim');
  const btnLimpar = document.getElementById('btnLimparPeriodo');
  const resumoTexto = document.getElementById('periodoResumoTexto');

  // Essa seção só existe na visão da gestora ("Últimos lançamentos").
  // Na visão do produtor esses elementos não existem — sem essa
  // proteção, o forEach mais abaixo travava a página inteira.
  if (!inputDataInicio) {
    return {
      onChange: () => {},
      aplicarData: () => {},
      aplicarDiasSelecionados: () => {},
      diasSelecionadosAtuais: () => []
    };
  }
  const inputFiltroProdutor = document.getElementById('filtroProdutorInput');
  const hiddenFiltroProdutor = document.getElementById('filtroProdutor');
  const sugestoesFiltroProdutor = document.getElementById('filtroProdutorSugestoes');
  const btnLimparFiltroProdutorInput = document.getElementById('btnLimparFiltroProdutorInput');

  let produtorId = '';
  let diasSelecionados = []; // dias avulsos escolhidos na lista "Dias com lançamento"
  const listeners = [];

   function renderSugestoesFiltroProdutor(lista) {
    sugestoesFiltroProdutor.innerHTML = '';
    if (!lista.length) {
      sugestoesFiltroProdutor.classList.add('hidden');
      return;
    }
    lista.forEach((p) => {
      const item = document.createElement('div');
      item.textContent = p.nome;

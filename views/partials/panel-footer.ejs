   // Câmera / Webcam
  let currentFacingMode = 'environment';

  async function iniciarStreamCamera(facingMode) {
    const video = document.getElementById('webcamVideo');
    if (mediaStream) {
      mediaStream.getTracks().forEach(track => track.stop());
    }
    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { exact: facingMode }, width: { ideal: 1280 }, height: { ideal: 1280 } }, audio: false });
    } catch (err) {
      mediaStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: facingMode, width: { ideal: 1280 }, height: { ideal: 1280 } }, audio: false });
    }
    video.srcObject = mediaStream;
    video.classList.toggle('scale-x-[-1]', facingMode === 'user');
    currentFacingMode = facingMode;
  }

  async function alternarCamera() {
    const novoModo = currentFacingMode === 'environment' ? 'user' : 'environment';
    try {
      await iniciarStreamCamera(novoModo);
    } catch (err) {
      showCustomAlert('Câmera não encontrada', 'Não foi possível trocar para essa câmera neste aparelho.');
    }
  }

  async function openCameraModal() {
    const menuPerfil = document.getElementById('photoOptionsMenu');
    if (menuPerfil) menuPerfil.classList.add('hidden');
    const menuGrupo = document.getElementById('chatAvatarMenu');
    if (menuGrupo) menuGrupo.classList.add('hidden');
    const modal = document.getElementById('cameraModal');

    try {
      await iniciarStreamCamera('environment');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } catch (err) {
      showCustomAlert('Câmera não encontrada', 'Não foi possível acessar a câmera. Verifique se ela está conectada e se você concedeu as permissões no navegador.');
    }
  }

 function takeSnapshot() {
    const video = document.getElementById('webcamVideo');
    const canvas = document.createElement('canvas');
    canvas.width = video.videoWidth || 640;
    canvas.height = video.videoHeight || 480;

    const ctx = canvas.getContext('2d');
    if (currentFacingMode === 'user') {
      ctx.translate(canvas.width, 0);
      ctx.scale(-1, 1);
    }
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

    const base64Photo = canvas.toDataURL('image/jpeg', 0.8);

    if (capturaFotoAlvo === 'grupo') {
      if (typeof salvarFotoGrupoCapturada === 'function') salvarFotoGrupoCapturada(base64Photo);
    } else if (capturaFotoAlvo === 'produto') {
      if (typeof salvarFotoProdutoCapturada === 'function') salvarFotoProdutoCapturada(base64Photo);
    } else {
      document.getElementById('previewPhoto').src = base64Photo;
      document.getElementById('profileFotoUrl').value = base64Photo;
    }

    closeCameraModal();
  }

  function closeCameraModal() {
    if (mediaStream) {
      mediaStream.getTracks().forEach(track => track.stop());
      mediaStream = null;
    }
    const modal = document.getElementById('cameraModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }


 function redimensionarImagemBase64(file, callback) {
    const MAX_SIZE = 500; // px, lado maior

    function finalizarComBitmap(bitmap) {
      let { width, height } = bitmap;
      if (width > height && width > MAX_SIZE) {
        height = Math.round(height * (MAX_SIZE / width));
        width = MAX_SIZE;
      } else if (height > MAX_SIZE) {
        width = Math.round(width * (MAX_SIZE / height));
        height = MAX_SIZE;
      }
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      canvas.getContext('2d').drawImage(bitmap, 0, 0, width, height);
      if (bitmap.close) bitmap.close();
      callback(canvas.toDataURL('image/jpeg', 0.75));
    }

    function viaImageFallback() {
      const objectUrl = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function() {
        let { width, height } = img;
        if (width > height && width > MAX_SIZE) {
          height *= MAX_SIZE / width;
          width = MAX_SIZE;
        } else if (height > MAX_SIZE) {
          width *= MAX_SIZE / height;
          height = MAX_SIZE;
        }
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        canvas.getContext('2d').drawImage(img, 0, 0, width, height);
        URL.revokeObjectURL(objectUrl);
        callback(canvas.toDataURL('image/jpeg', 0.75));
      };
      img.onerror = function() {
        URL.revokeObjectURL(objectUrl);
        if (typeof showCustomAlert === 'function') {
          showCustomAlert('Erro ao processar imagem', 'Não foi possível abrir essa foto. Tente novamente ou escolha outra imagem.');
        }
      };
      img.src = objectUrl;
    }

    if (window.createImageBitmap) {
      // Decodifica a foto já numa resolução reduzida, evitando carregar
      // o bitmap original (que pode ter dezenas de megapixels) na memória.
      createImageBitmap(file, { resizeWidth: 1200, resizeQuality: 'medium' })
        .then(finalizarComBitmap)
        .catch(viaImageFallback);
    } else {
      viaImageFallback();
    }
  }
  function handleFileSelect(event) {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith('image/')) {
      showCustomAlert('Arquivo Inválido', 'Por favor, selecione uma imagem válida.');
      return;
    }

    redimensionarImagemBase64(file, (base64Image) => {
      document.getElementById('previewPhoto').src = base64Image;
      document.getElementById('profileFotoUrl').value = base64Image;
    });
    event.target.value = '';
  }

  // Volta a foto de perfil para o padrão (a folhinha), limpando o valor salvo.
  const FOTO_PADRAO_SVG = 'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cdefs%3E%3ClinearGradient id=%27bg%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23d1fae5%27/%3E%3Cstop offset=%271%27 stop-color=%27%23a7f3d0%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Ccircle cx=%2750%27 cy=%2750%27 r=%2750%27 fill=%27url(%23bg)%27/%3E%3Cpath d=%27M50 74V44%27 stroke=%27%23047857%27 stroke-width=%274%27 stroke-linecap=%27round%27/%3E%3Cpath d=%27M50 50c-15-1-24-13-22-27 15 1 24 13 22 27z%27 fill=%27%2310b981%27/%3E%3Cpath d=%27M50 44c15-1 24-13 22-27-15 1-24 13-22 27z%27 fill=%27%2334d399%27/%3E%3Ccircle cx=%2750%27 cy=%2778%27 r=%276%27 fill=%27%23047857%27/%3E%3C/svg%3E';
  function removerFotoPerfil() {
    const menu = document.getElementById('photoOptionsMenu');
    if (menu) menu.classList.add('hidden');

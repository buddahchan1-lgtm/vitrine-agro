<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }

  /* No celular, segurar o dedo na mensagem não seleciona o texto (some
     com as bolinhas azuis nativas) — o toque e segure abre nosso menu.
     No computador (mouse) a seleção continua normal. */
    @media (pointer: coarse) {
    #chatMensagens, #chatMensagens *,
    #listaMuralMensagens, #listaMuralMensagens * {
      -webkit-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
      touch-action: manipulation;
    }
  }

  /* Destaque da mensagem selecionada, estilo WhatsApp */
  .bolha-selecionada {
    background-color: rgba(16, 185, 129, 0.20) !important;
    border-radius: 0.75rem;
  }
</style>

<!-- ========================================================= -->
<!-- MODAL DE EDIÇÃO DE PERFIL                                 -->
<!-- ========================================================= -->
<div id="profileModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4" onclick="closeOnBackdrop(event, closeProfileModal)">
  <div class="w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl transition-all relative">
    
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
      <h3 class="text-lg font-bold text-slate-900">Editar Meu Perfil</h3>
      <button type="button" onclick="closeProfileModal()" class="text-slate-400 hover:text-slate-600 font-bold text-2xl leading-none">&times;</button>
    </div>

    <form id="profileForm" onsubmit="saveProfile(event)" class="space-y-4 text-left">
      
      <!-- Área do Avatar + Popover de Opções -->
      <div class="flex flex-col items-center gap-2 pb-2 relative">
        <div class="relative">
          
          <!-- Círculo Clicável -->
          <div 
            id="avatarButton" 
            onclick="togglePhotoMenu(event)"
            class="relative group cursor-pointer rounded-full p-1 border-2 border-dashed border-slate-300 hover:border-agro-500 transition"
            title="Clique para opções da foto"
          >
             <img 
              id="previewPhoto" 
              src="<%= currentUser.foto || 'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cdefs%3E%3ClinearGradient id=%27bg%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23d1fae5%27/%3E%3Cstop offset=%271%27 stop-color=%27%23a7f3d0%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Ccircle cx=%2750%27 cy=%2750%27 r=%2750%27 fill=%27url(%23bg)%27/%3E%3Cpath d=%27M50 74V44%27 stroke=%27%23047857%27 stroke-width=%274%27 stroke-linecap=%27round%27/%3E%3Cpath d=%27M50 50c-15-1-24-13-22-27 15 1 24 13 22 27z%27 fill=%27%2310b981%27/%3E%3Cpath d=%27M50 44c15-1 24-13 22-27-15 1-24 13-22 27z%27 fill=%27%2334d399%27/%3E%3Ccircle cx=%2750%27 cy=%2778%27 r=%276%27 fill=%27%23047857%27/%3E%3C/svg%3E' %>" 
              class="h-24 w-24 rounded-full object-cover shadow-md"
              draggable="false"
            />
            <div class="absolute bottom-0 right-0 rounded-full bg-agro-600 p-2 text-white shadow-md group-hover:bg-agro-700 transition">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            </div>
          </div>

          <!-- Menu estilo WhatsApp -->
          <div 
            id="photoOptionsMenu" 
                 class="hidden absolute left-1/2 -translate-x-1/2 top-full mt-2 w-48 z-20 rounded-2xl bg-white p-1.5 shadow-xl border border-slate-200 text-slate-700 text-sm"
          >
             <button 
              type="button" 
              onclick="viewCurrentPhoto()" 
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>Mostrar foto</span>
            </button>

            <button 
              type="button" 
              onclick="openCameraModal()" 
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              <span>Tirar foto</span>
            </button>

            <button 
              type="button" 
              onclick="triggerFileInput()" 
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L8.6 3.3A2 2 0 0 0 6.93 2.5H4a2 2 0 0 0-2 2v13.5a2 2 0 0 0 2 2z"/></svg>
              <span>Carregar foto</span>
            </button>

            <div class="my-1 border-t border-slate-100"></div>

            <button 
              type="button" 
              onclick="removerFotoPerfil()" 
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-rose-50 transition text-left font-medium text-rose-600"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
                <span>Remover foto</span>
            </button>
          </div>

        </div>

         <!-- Inputs ocultos para controle da imagem e upload local -->
       <input type="file" id="photoFileInput" accept="image/*" class="hidden" onchange="handleFileSelect(event)" />
        <input type="hidden" id="profileFotoUrl" value="<%= currentUser.foto || '' %>" />
         <span class="text-xs text-slate-500">Clique na foto para ver opções</span>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Nome Completo</label>
        <input type="text" id="profileNome" value="<%= currentUser.nome %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">E-mail</label>
        <input type="email" id="profileEmail" value="<%= currentUser.email %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">WhatsApp / Telefone</label>
        <input type="tel" id="profileWhatsapp" placeholder="(28) 99999-9999" value="<%= currentUser.whatsapp || '' %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeProfileModal()" class="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" id="btnSaveProfile" class="rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-agro-700 transition">Salvar Alterações</button>
      </div>
     </form>
  </div>
</div>

<!-- Modal: Alterar senha -->
<div id="modalAlterarSenha" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4">
  <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-lg font-bold text-slate-900">Alterar senha</h3>
      <button type="button" id="btnFecharAlterarSenha" class="text-2xl leading-none text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <form id="formAlterarSenha" class="mt-4 space-y-3">
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">Senha atual</label>
        <input type="password" id="senhaAtualInput" required autocomplete="current-password" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">Nova senha</label>
        <input type="password" id="senhaNovaInput" required minlength="6" autocomplete="new-password" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
        <p class="mt-1 text-xs text-slate-400">Mínimo de 6 caracteres.</p>
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">Confirmar nova senha</label>
        <input type="password" id="senhaNovaConfirmarInput" required minlength="6" autocomplete="new-password" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
      </div>
      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button" id="btnCancelarAlterarSenha" class="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" id="btnSalvarAlterarSenha" class="rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white hover:bg-agro-700">Salvar nova senha</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Cadastrar administrador -->
<div id="modalCadastrarAdmin" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4">
  <div class="w-full max-w-md rounded-3xl bg-white p-6 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-lg font-bold text-slate-900">Cadastrar administrador</h3>
      <button type="button" id="btnFecharCadastrarAdmin" class="text-2xl leading-none text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <form action="/painel/administradores" method="POST" class="mt-4 space-y-3">
      <input name="nome" type="text" required placeholder="Nome do administrador" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <input name="email" type="email" required placeholder="E-mail de acesso" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <input name="senha" type="text" required placeholder="Senha inicial" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <button type="submit" class="w-full rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-agro-700">Cadastrar administrador</button>
    </form>
  </div>
</div>

<!-- Modal: Cadastrar produtor (via engrenagem) -->

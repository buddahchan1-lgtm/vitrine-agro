<!-- Modal: Visualização da Foto -->
<div id="viewPhotoModal" class="fixed inset-0 z-[95] hidden flex items-center justify-center bg-slate-900/80 backdrop-blur-md p-4" onclick="closeViewPhoto()">
  <div class="relative max-w-lg w-full flex flex-col items-center">
    <img id="fullPhotoView" src="" class="max-h-[80vh] max-w-full rounded-2xl shadow-2xl object-contain" />
    <p class="text-white/80 text-xs mt-3">Clique em qualquer lugar para fechar</p>
  </div>
</div>

<!-- Modal: Captura de Câmera (tela cheia, estilo WhatsApp) -->
<div id="cameraModal" class="fixed inset-0 z-[80] hidden flex-col bg-black">
  <div class="relative flex-1 overflow-hidden">
    <video id="webcamVideo" autoplay playsinline class="absolute inset-0 h-full w-full object-contain bg-black transition-transform"></video>
    <button type="button" onclick="closeCameraModal()" class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-black/50 text-2xl leading-none text-white" aria-label="Fechar câmera">&times;</button>
    <button type="button" onclick="alternarCamera()" class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full bg-black/50 text-white" aria-label="Virar câmera">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
    </button>
  </div>
  <div class="flex items-center justify-center bg-black py-6">
    <button type="button" onclick="takeSnapshot()" class="flex h-16 w-16 items-center justify-center rounded-full border-4 border-white bg-white/20" aria-label="Capturar foto">
      <span class="h-12 w-12 rounded-full bg-white"></span>
    </button>
  </div>
</div>

<!-- Modal Estilizado de Aviso/Erro (Estilo WhatsApp/Custom) -->
<div id="customAlertModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4" onclick="closeOnBackdrop(event, closeCustomAlert)">
  <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl text-center text-slate-900 border border-slate-200 space-y-4">
    <h4 id="customAlertTitle" class="text-base font-bold text-slate-900">Aviso</h4>
    <p id="customAlertMessage" class="text-sm text-slate-600 leading-relaxed"></p>
    <div class="pt-2">
      <button type="button" onclick="closeCustomAlert()" class="w-full rounded-2xl bg-agro-600 hover:bg-agro-700 py-2.5 text-sm font-bold text-white transition">
        OK
      </button>
    </div>
  </div>
</div>

<!-- Modal Estilizado de Confirmação (usado para excluir mensagens etc.) -->
<div id="confirmModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4" onclick="closeOnBackdrop(event, closeConfirmModal)">
  <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl text-center text-slate-900 border border-slate-200 space-y-4">
    <h4 id="confirmTitle" class="text-base font-bold text-slate-900">Confirmar</h4>
    <p id="confirmMessage" class="text-sm text-slate-600 leading-relaxed"></p>
    <div class="flex gap-3 pt-2">
      <button type="button" id="confirmCancelBtn" class="flex-1 rounded-2xl border border-slate-200 text-slate-600 hover:bg-slate-50 py-2.5 text-sm font-bold transition">Cancelar</button>
      <button type="button" id="confirmOkBtn" class="flex-1 rounded-2xl bg-agro-600 hover:bg-agro-700 py-2.5 text-sm font-bold text-white transition">Excluir</button>
    </div>
  </div>
</div>

<script>
  let mediaStream = null;
 let originalPhotoUrl = "<%= currentUser.foto || 'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cdefs%3E%3ClinearGradient id=%27bg%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23d1fae5%27/%3E%3Cstop offset=%271%27 stop-color=%27%23a7f3d0%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Ccircle cx=%2750%27 cy=%2750%27 r=%2750%27 fill=%27url(%23bg)%27/%3E%3Cpath d=%27M50 74V44%27 stroke=%27%23047857%27 stroke-width=%274%27 stroke-linecap=%27round%27/%3E%3Cpath d=%27M50 50c-15-1-24-13-22-27 15 1 24 13 22 27z%27 fill=%27%2310b981%27/%3E%3Cpath d=%27M50 44c15-1 24-13 22-27-15 1-24 13-22 27z%27 fill=%27%2334d399%27/%3E%3Ccircle cx=%2750%27 cy=%2778%27 r=%276%27 fill=%27%23047857%27/%3E%3C/svg%3E' %>";
  let capturaFotoAlvo = 'perfil'; // 'perfil' ou 'grupo' - define para onde vai a foto tirada/carregada

 // Guarda onde o clique COMEÇOU (mousedown/touchstart), não só onde terminou.
  let pontoDeInicioClique = null;
  document.addEventListener('mousedown', (e) => { pontoDeInicioClique = e.target; }, true);
  document.addEventListener('touchstart', (e) => { pontoDeInicioClique = e.target; }, true);

  // Fecha um modal só se o clique COMEÇOU e TERMINOU no fundo escurecido.
  // Assim, selecionar texto e soltar o mouse fora não fecha mais nada.
  function closeOnBackdrop(e, closeFn) {
    if (e.target === e.currentTarget && pontoDeInicioClique === e.currentTarget) closeFn();
  }

  // Função para exibir alertas sem popup nativo do navegador
  function showCustomAlert(title, message) {
    document.getElementById('customAlertTitle').innerText = title;
    document.getElementById('customAlertMessage').innerText = message;
    document.getElementById('customAlertModal').classList.remove('hidden');
  }

  function closeCustomAlert() {
    document.getElementById('customAlertModal').classList.add('hidden');
  }

  // Confirmação estilizada (substitui o confirm() nativo do navegador para excluir mensagens).
  let _confirmCallback = null;
  function showConfirm(title, message, onConfirm) {
    document.getElementById('confirmTitle').innerText = title;
    document.getElementById('confirmMessage').innerText = message;
    _confirmCallback = onConfirm;
    document.getElementById('confirmModal').classList.remove('hidden');
  }
  function closeConfirmModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    _confirmCallback = null;
  }
 document.getElementById('confirmCancelBtn').addEventListener('click', closeConfirmModal);
  document.getElementById('confirmOkBtn').addEventListener('click', () => {
    const cb = _confirmCallback;
    closeConfirmModal();
    if (cb) cb();
  });

 // Menu de configurações (engrenagem)
  const btnAbrirConfig = document.getElementById('btnAbrirConfig');
  const menuConfig = document.getElementById('menuConfig');
  if (btnAbrirConfig && menuConfig) {
    btnAbrirConfig.addEventListener('click', (e) => {
      e.stopPropagation();
      const painelNotifAberto = document.getElementById('painelNotificacoes');
      if (painelNotifAberto) painelNotifAberto.classList.add('hidden');
      menuConfig.classList.toggle('hidden');
    });
  }

   // Alterar senha
  const modalAlterarSenha = document.getElementById('modalAlterarSenha');
  const btnAbrirAlterarSenha = document.getElementById('btnAbrirAlterarSenha');
  if (btnAbrirAlterarSenha) {
    const formAlterarSenha = document.getElementById('formAlterarSenha');
    const senhaAtualInput = document.getElementById('senhaAtualInput');
    const senhaNovaInput = document.getElementById('senhaNovaInput');
    const senhaNovaConfirmarInput = document.getElementById('senhaNovaConfirmarInput');
    const btnSalvarAlterarSenha = document.getElementById('btnSalvarAlterarSenha');

    function fecharModalAlterarSenha() {
      formAlterarSenha.reset();
      modalAlterarSenha.classList.add('hidden');
    }

    btnAbrirAlterarSenha.addEventListener('click', () => {
      menuConfig.classList.add('hidden');
      modalAlterarSenha.classList.remove('hidden');
    });
    document.getElementById('btnFecharAlterarSenha').addEventListener('click', fecharModalAlterarSenha);
    document.getElementById('btnCancelarAlterarSenha').addEventListener('click', fecharModalAlterarSenha);
    modalAlterarSenha.addEventListener('click', (e) => closeOnBackdrop(e, fecharModalAlterarSenha));

    formAlterarSenha.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (senhaNovaInput.value !== senhaNovaConfirmarInput.value) {
        showCustomAlert('Senhas não conferem', 'A nova senha e a confirmação precisam ser iguais.');
        return;
      }
      if (senhaNovaInput.value.length < 6) {
        showCustomAlert('Senha muito curta', 'A nova senha deve ter ao menos 6 caracteres.');
        return;
      }

      btnSalvarAlterarSenha.disabled = true;
      btnSalvarAlterarSenha.textContent = 'Salvando...';

      try {
        const resp = await fetch('/painel/senha', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            senhaAtual: senhaAtualInput.value,
            senhaNova: senhaNovaInput.value
          })
        });
        const data = await resp.json().catch(() => ({}));

        if (!resp.ok || !data.success) {
          showCustomAlert('Não foi possível alterar', data.message || 'Verifique a senha atual e tente novamente.');
          return;
        }

        fecharModalAlterarSenha();
        showCustomAlert('Senha alterada', 'Sua senha foi atualizada com sucesso.');
      } catch (err) {
        showCustomAlert('Erro de conexão', 'Não foi possível falar com o servidor. Tente novamente.');
      } finally {
        btnSalvarAlterarSenha.disabled = false;
        btnSalvarAlterarSenha.textContent = 'Salvar nova senha';
      }
    });
  }


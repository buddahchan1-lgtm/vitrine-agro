      <h3 class="text-lg font-bold text-slate-900">Cadastrar produtor</h3>
      <button type="button" id="btnFecharCadastrarProdutorRapido" class="text-2xl leading-none text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <form action="/painel/produtores" method="POST" class="mt-4 space-y-3">
      <input name="nome" type="text" required placeholder="Nome do produtor" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <input name="email" type="email" required placeholder="E-mail de acesso" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <input name="senha" type="text" required placeholder="Senha inicial" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <input name="comunidade" type="text" placeholder="Comunidade / Localidade (opcional)" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 outline-none focus:border-agro-500 focus:bg-white" />
      <button type="submit" class="w-full rounded-2xl bg-agro-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-agro-700">Cadastrar produtor</button>

    // Dispara o menu de contexto com o botão direito (desktop) ou toque
  // prolongado / "segurar o dedo" (celular), como no WhatsApp.
  function anexarMenuContexto(el, handler) {
    let pressTimer = null;
    let inicioX = 0, inicioY = 0;
    let pointerIdAtivo = null;

    el.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (Date.now() - ultimoToqueLongoEm < 600) return;
      handler(e, { x: e.clientX, y: e.clientY });
    });

    // Toque real no celular: usamos Pointer Events (em vez de touch*) e
    // "prendemos" o toque no elemento com setPointerCapture. Isso evita
    // que o gesto nativo de toque prolongado do Android/iOS (seleção de
    // texto, menu do sistema) roube o toque antes do nosso temporizador
    // completar — era isso que fazia o menu nunca aparecer no celular
    // de verdade, mesmo funcionando com o mouse.
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return; // botão direito já tratado acima
      if (e.target.closest('.btn-selecionar-mural, .btn-opcoes-msg')) return; // botão de opções cuida disso via click
      // Impede o navegador de gerar um "click" de compatibilidade
      // depois que o dedo soltar a tela. Sem isso, esse clique extra
      // caía no listener de clique da bolha e desfazia a seleção
      // que acabamos de fazer — por isso ela aparecia e sumia rápido.
      if (e.cancelable) e.preventDefault();
      inicioX = e.clientX;
      inicioY = e.clientY;
      pointerIdAtivo = e.pointerId;
      try { el.setPointerCapture(e.pointerId); } catch (err) {}
      pressTimer = setTimeout(() => {
        pressTimer = null;
        ultimoToqueLongoEm = Date.now();
        handler(e, { x: inicioX, y: inicioY });
      }, 500);
    });

    const cancelarToque = (e) => {
      if (e && e.pointerId !== undefined && e.pointerId !== pointerIdAtivo) return;
      if (!pressTimer) { pointerIdAtivo = null; return; }
      if (e && e.type === 'pointermove') {
        const dx = Math.abs(e.clientX - inicioX);
        const dy = Math.abs(e.clientY - inicioY);
        if (dx < 10 && dy < 10) return;
      }
      clearTimeout(pressTimer);
      pressTimer = null;
      pointerIdAtivo = null;
    };
    el.addEventListener('pointerup', cancelarToque);
    el.addEventListener('pointercancel', cancelarToque);
    el.addEventListener('pointermove', cancelarToque);
  }

  // ---- Seleção de mensagens (multi-seleção estilo WhatsApp) ----
  function atualizarBarraSelecao() {
    const alvos = Array.from(mensagensSelecionadas.values());
    const contador = document.getElementById('contadorSelecaoMensagem');
    if (contador) contador.textContent = alvos.length + (alvos.length === 1 ? ' selecionada' : ' selecionadas');

    // Editar só faz sentido com exatamente 1 mensagem marcada, E ela
    // precisa ser sua. Antes o botão aparecia com qualquer mensagem
    // alheia selecionada, permitindo editar texto de outras pessoas.
    const podeEditarSelecao = alvos.length === 1 && alvos[0].souAutor;
    btnSelecaoEditar.classList.toggle('hidden', !podeEditarSelecao);

    // Excluir só aparece se TODAS as selecionadas puderem ser apagadas por mim.
    const podeExcluirTodas = alvos.every((alvo) => (alvo.tipo === 'mural' ? souAdmin : alvo.souAutor));
    btnSelecaoExcluir.classList.toggle('hidden', !podeExcluirTodas);
  }

  function alternarSelecaoMensagem(alvo) {
    const chave = alvo.tipo + ':' + alvo.id;
    if (mensagensSelecionadas.has(chave)) {
      mensagensSelecionadas.get(chave).elHighlight.classList.remove('bolha-selecionada');
      mensagensSelecionadas.delete(chave);
    } else {
      alvo.elHighlight.classList.add('bolha-selecionada');
      mensagensSelecionadas.set(chave, alvo);
    }

    if (!mensagensSelecionadas.size) {
      limparSelecaoMensagem(alvo.tipo);
      return;
    }

    barraSelecaoMensagem.classList.remove('hidden');
    barraSelecaoMensagem.classList.add('flex');
    if (alvo.tipo === 'mural') {
      cabecalhoPadrao.classList.add('hidden');
      abasMensagens.classList.add('hidden');
    } else {
      cabecalhoChat.classList.add('hidden');
      cabecalhoChat.classList.remove('flex');
    }
    atualizarBarraSelecao();
  }

  function alternarSelecaoChat(msg, wrap) {
    alternarSelecaoMensagem({
      tipo: 'privado',
      id: msg.id,
      conversaId: conversaAtual.id,
      textoAtual: msg.texto,
      elHighlight: wrap,
      souAutor: msg.remetente_id === meuId
    });
  }

  function alternarSelecaoMural(m, article) {
    alternarSelecaoMensagem({
      tipo: 'mural',
      id: m.id,
      conversaId: null,
      textoAtual: m.texto,
      elHighlight: article,
      souAutor: souAdmin
    });
  }

  function limparSelecaoMensagem(tipoForcado) {
    if (!mensagensSelecionadas.size && !tipoForcado) return;
    const tipoAtual = tipoForcado || mensagensSelecionadas.values().next().value.tipo;
    mensagensSelecionadas.forEach((alvo) => alvo.elHighlight.classList.remove('bolha-selecionada'));
    mensagensSelecionadas.clear();
    barraSelecaoMensagem.classList.add('hidden');
    barraSelecaoMensagem.classList.remove('flex');
    if (tipoAtual === 'mural') {
      cabecalhoPadrao.classList.remove('hidden');
      abasMensagens.classList.remove('hidden');
    } else if (conversaAtual) {
      cabecalhoChat.classList.remove('hidden');
      cabecalhoChat.classList.add('flex');
    }
  }

  btnCancelarSelecao.addEventListener('click', limparSelecaoMensagem);

  btnSelecaoCopiar.addEventListener('click', async () => {
    if (!mensagensSelecionadas.size) return;
    const texto = Array.from(mensagensSelecionadas.values()).map((a) => a.textoAtual).join('\n');
    try {
      await navigator.clipboard.writeText(texto);
    } catch (err) {
      const areaTemp = document.createElement('textarea');
      areaTemp.value = texto;
      areaTemp.style.position = 'fixed';
      areaTemp.style.opacity = '0';
      document.body.appendChild(areaTemp);
      areaTemp.select();
      document.execCommand('copy');
      document.body.removeChild(areaTemp);
    }
    limparSelecaoMensagem();
  });

  btnSelecaoEditar.addEventListener('click', () => {
    if (mensagensSelecionadas.size !== 1) return;
    const alvo = mensagensSelecionadas.values().next().value;
    if (!alvo.souAutor) return; // segurança extra: nunca editar mensagem alheia
    limparSelecaoMensagem();
    if (alvo.tipo === 'mural') iniciarEdicaoMural(alvo);
    else iniciarEdicaoChat(alvo);
  });

  btnSelecaoExcluir.addEventListener('click', () => {
    if (!mensagensSelecionadas.size) return;
    const alvos = Array.from(mensagensSelecionadas.values());
    const tipo = alvos[0].tipo;
    limparSelecaoMensagem();
    const titulo = alvos.length === 1 ? 'Excluir mensagem?' : `Excluir ${alvos.length} mensagens?`;
    showConfirm(titulo, 'Essa ação não pode ser desfeita.', async () => {
      let resultado = null;
      if (tipo === 'mural') {
        for (const alvo of alvos) {
          resultado = await apiFetch(`/painel/mensagens/${alvo.id}/excluir`, { method: 'POST' }, 'Não foi possível excluir o aviso.');
        }
        if (resultado && resultado.success) {
          listaMuralEl.innerHTML = '';
          const mensagens = resultado.mensagens || [];
          if (!mensagens.length) muralVazioEl.classList.remove('hidden');
          else { muralVazioEl.classList.add('hidden'); mensagens.forEach((m) => listaMuralEl.appendChild(renderMensagemMural(m))); }
        }
      } else {
        for (const alvo of alvos) {
          resultado = await apiFetch(`/painel/conversas/${alvo.conversaId}/mensagens/${alvo.id}/excluir`, { method: 'POST' }, 'Não foi possível excluir a mensagem.');
        }
        if (resultado && resultado.success) renderChatMensagens(resultado.mensagens || []);
      }
    });
  });

  function iniciarEdicaoMural(alvo) {
    const article = alvo.elHighlight;
    const textoEl = article.querySelector('[data-msg-texto]');
    const overlayEdicao = article.querySelector('.overlay-selecionar-mural');
    if (overlayEdicao) overlayEdicao.style.display = 'none';
    const original = alvo.textoAtual;

    const textarea = document.createElement('textarea');
    textarea.className = 'w-full max-w-xs resize-none border-0 bg-transparent p-0 text-lg text-inherit outline-none placeholder-white/60';
    textarea.rows = 1;
    textarea.maxLength = 1000;
    textarea.value = original;
    textarea.style.height = 'auto';
    setTimeout(() => { textarea.style.height = textarea.scrollHeight + 'px'; }, 0);
    textarea.addEventListener('input', () => {
      textarea.style.height = 'auto';
      textarea.style.height = textarea.scrollHeight + 'px';
    });
    // No computador, Enter (sem Shift) salva a edição, como no restante do app.
    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !ehDispositivoTocavel) {
        e.preventDefault();
        acoes.children[1].click();
      }
    });

    function ajustarAlturaEdicaoMural() {
      textarea.style.height = 'auto';
      textarea.style.height = Math.min(textarea.scrollHeight, 220) + 'px';
    }

    const contadorEdicao = document.createElement('p');
    contadorEdicao.className = 'mt-1 text-right text-xs font-medium text-slate-400';
    contadorEdicao.textContent = original.length + ' / 3000';

    const acoes = document.createElement('div');
    acoes.className = 'mt-2 flex justify-end gap-2';
    acoes.innerHTML = `
      <button type="button" class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100">Cancelar</button>
      <button type="button" class="rounded-xl bg-agro-600 px-3 py-2 text-sm font-semibold text-white hover:bg-agro-700">Salvar</button>
    `;

    textoEl.replaceWith(textarea);
    textarea.after(contadorEdicao);
    contadorEdicao.after(acoes);

    ajustarAlturaEdicaoMural();
    textarea.addEventListener('input', () => {
      contadorEdicao.textContent = textarea.value.length + ' / 3000';
      ajustarAlturaEdicaoMural();
    });
    textarea.focus();

    acoes.children[0].addEventListener('click', () => carregarMural());
    acoes.children[1].addEventListener('click', async () => {
      const novoTexto = textarea.value.trim();

      // Apagou tudo e confirmou (Enter ou botão Salvar): pergunta se
      // quer excluir o aviso, em vez de só travar com "muito curto".
      if (novoTexto.length === 0) {
        showConfirm('Excluir aviso?', 'Você apagou todo o texto. Deseja excluir este aviso?', async () => {
          const data = await apiFetch(`/painel/mensagens/${alvo.id}/excluir`, { method: 'POST' }, 'Não foi possível excluir o aviso.');
          if (data && data.success) {
            listaMuralEl.innerHTML = '';
            const mensagens = data.mensagens || [];
            if (!mensagens.length) muralVazioEl.classList.remove('hidden');
            else { muralVazioEl.classList.add('hidden'); mensagens.forEach((m) => listaMuralEl.appendChild(renderMensagemMural(m))); }
          }
        });
        return;
      }

      if (novoTexto.length < 3) {
        showCustomAlert('Aviso muito curto', 'Escreva ao menos 3 caracteres.');
        return;
      }
      const data = await apiFetch(`/painel/mensagens/${alvo.id}/editar`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texto: novoTexto })
      }, 'Não foi possível salvar a edição.');
      if (data && data.success) {
        listaMuralEl.innerHTML = '';
        (data.mensagens || []).forEach((m) => listaMuralEl.appendChild(renderMensagemMural(m)));
      }
    });
  }

 function iniciarEdicaoChat(alvo) {

        <button type="submit" aria-label="Enviar mensagem" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-agro-600 text-white transition hover:bg-agro-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="6 11 12 5 18 11"/></svg>
        </button>
      </form>
    </div>

  </div>
</div>

<!-- Menu de contexto (Editar/Excluir) estilo WhatsApp, reaproveitado para todas as mensagens -->
<div id="menuMensagemContexto" class="hidden fixed z-[90] w-44 rounded-2xl bg-white p-1.5 shadow-xl border border-slate-200 text-slate-700 text-sm">
  <button type="button" id="btnMenuCopiarMsg" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    <span>Copiar</span>
  </button>
  <button type="button" id="btnMenuEditarMsg" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
    <span>Editar</span>
  </button>
  <button type="button" id="btnMenuExcluirMsg" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-rose-50 transition text-left font-medium text-rose-600">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
    <span>Excluir</span>
  </button>
</div>

<!-- Menu de contexto da conversa (fixar/arquivar/excluir) -->
<div id="menuConversaContexto" class="hidden fixed z-[90] w-48 rounded-2xl bg-white p-1.5 shadow-xl border border-slate-200 text-slate-700 text-sm">
  <button type="button" id="btnMenuFixarConversa" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
    <svg id="iconMenuFixar" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v5M8 13.5V7a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v6.5l1.5 2.5h-11z"/></svg>
    <span id="txtMenuFixarConversa">Fixar</span>
  </button>
  <button type="button" id="btnMenuArquivarConversa" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg>
    <span id="txtMenuArquivarConversa">Arquivar</span>
  </button>
  <button type="button" id="btnMenuExcluirConversa" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-rose-50 transition text-left font-medium text-rose-600">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
    <span>Excluir contato</span>
  </button>
</div>

<!-- Modal: Nova conversa (criar grupo) -->
<div id="modalNovaConversa" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4">
  <div class="flex max-h-[85vh] w-full max-w-sm flex-col overflow-hidden rounded-3xl bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
      <div>
        <h3 class="text-lg font-bold text-slate-900">Criar grupo</h3>
        <p class="text-xs text-slate-400">Reúna várias pessoas numa mesma conversa</p>
      </div>
      <button type="button" id="btnFecharNovaConversa" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-2xl leading-none text-slate-400 hover:bg-slate-100 hover:text-slate-600">&times;</button>
    </div>

    <div class="px-6 pt-5">
      <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Nome do grupo</label>
      <input type="text" id="nomeGrupoInput" placeholder="Ex.: Feira de Sábado" class="w-full rounded-2xl border-2 border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none focus:border-agro-500 focus:bg-white" />
    </div>

    <div class="mt-5 flex items-center justify-between px-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Participantes</p>
      <p class="text-xs font-semibold text-agro-600">Escolha ao menos 2</p>
    </div>
    <div class="mt-2 flex-1 space-y-1 overflow-y-auto px-4 pb-2" id="listaContatos"></div>

    <div class="border-t border-slate-100 p-4">
      <button type="button" id="btnConfirmarNovaConversa" class="w-full rounded-2xl bg-agro-600 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-agro-700 disabled:opacity-60">Criar grupo</button>
    </div>
  </div>
</div>

<!-- Modal: Participantes do grupo -->
<div id="modalParticipantes" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4">
  <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-lg font-bold text-slate-900">Participantes do grupo</h3>
      <button type="button" id="btnFecharParticipantes" class="text-2xl leading-none text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <div class="mt-4 max-h-80 space-y-2 overflow-y-auto" id="listaParticipantes"></div>
  </div>
</div>

<!-- Modal: Editar foto do grupo -->
<div id="modalFotoGrupo" class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4">
  <div class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-lg font-bold text-slate-900">Foto do grupo</h3>
      <button type="button" id="btnFecharFotoGrupo" class="text-2xl leading-none text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <p class="mt-3 text-sm text-slate-500">Qualquer pessoa do grupo pode trocar a foto.</p>
    <input type="url" id="inputFotoGrupo" placeholder="URL da nova foto" class="mt-4 w-full rounded-2xl border-2 border-slate-200 bg-slate-50 px-4 py-3 text-base outline-none focus:border-agro-500" />
    <button type="button" id="btnSalvarFotoGrupo" class="mt-4 w-full rounded-2xl bg-agro-600 px-4 py-3 text-base font-bold text-white hover:bg-agro-700 disabled:opacity-60">Salvar foto</button>
  </div>
</div>

<script>
(function () {
  const souAdmin = <%= currentUser.tipo_acesso === 'admin' ? 'true' : 'false' %>;
  const meuId = <%= currentUser.id %>;
  const btnAbrir = document.getElementById('btnAbrirConversas');
  const modalMensagens = document.getElementById('modalMensagensCentral');
  const btnFecharMensagens = document.getElementById('btnFecharMensagensCentral');
  const listaEl = document.getElementById('listaConversas');
  const vaziaEl = document.getElementById('listaConversasVazia');
  const badge = document.getElementById('badgeConversas');
  const btnNotif = document.getElementById('btnAbrirNotificacoes');
  const painelNotif = document.getElementById('painelNotificacoes');
  const listaNotifEl = document.getElementById('listaNotificacoes');
  const notifVazioEl = document.getElementById('notificacoesVazio');
  const badgeNotif = document.getElementById('badgeNotificacoes');
  if (!btnAbrir) return;

  const cabecalhoPadrao = document.getElementById('cabecalhoMensagensPadrao');
  const cabecalhoChat = document.getElementById('cabecalhoChat');
  const abasMensagens = document.getElementById('abasMensagens');
  const barraSelecaoMensagem = document.getElementById('barraSelecaoMensagem');
  const btnCancelarSelecao = document.getElementById('btnCancelarSelecao');
  const btnSelecaoCopiar = document.getElementById('btnSelecaoCopiar');
  const btnSelecaoEditar = document.getElementById('btnSelecaoEditar');
  const btnSelecaoExcluir = document.getElementById('btnSelecaoExcluir');
  let mensagensSelecionadas = new Map(); // chave "tipo:id" -> { tipo, id, conversaId, textoAtual, elHighlight, souAutor }
  let ultimoToqueLongoEm = 0;
  const chatAvatarWrap = document.getElementById('chatAvatarWrap');
  const chatAvatarButton = document.getElementById('chatAvatarButton');
  const chatAvatarMenu = document.getElementById('chatAvatarMenu');
  const btnChatVerFoto = document.getElementById('btnChatVerFoto');
  const btnChatTirarFoto = document.getElementById('btnChatTirarFoto');
  const btnChatCarregarFoto = document.getElementById('btnChatCarregarFoto');
  const chatFotoFileInput = document.getElementById('chatFotoFileInput');
  const chatInfoArea = document.getElementById('chatInfoArea');
  const chatSubtitulo = document.getElementById('chatSubtitulo');
  const painelChat = document.getElementById('painelChat');
  const btnVoltarChat = document.getElementById('btnVoltarChat');

  const modalNova = document.getElementById('modalNovaConversa');
  const listaContatosEl = document.getElementById('listaContatos');
  const nomeGrupoInput = document.getElementById('nomeGrupoInput');
  const btnConfirmarGrupo = document.getElementById('btnConfirmarNovaConversa');

  const modalParticipantes = document.getElementById('modalParticipantes');
  const listaParticipantesEl = document.getElementById('listaParticipantes');

  const modalFotoGrupo = document.getElementById('modalFotoGrupo');
  const inputFotoGrupo = document.getElementById('inputFotoGrupo');
  const btnSalvarFotoGrupo = document.getElementById('btnSalvarFotoGrupo');

  const listaMuralEl = document.getElementById('listaMuralMensagens');
  const muralVazioEl = document.getElementById('muralVazio');
  const formPublicarMural = document.getElementById('formPublicarMural');

  const menuContexto = document.getElementById('menuMensagemContexto');
  const btnMenuCopiar = document.getElementById('btnMenuCopiarMsg');
  const btnMenuEditar = document.getElementById('btnMenuEditarMsg');
  const btnMenuExcluir = document.getElementById('btnMenuExcluirMsg');

   let contatosCache = [];
  let conversasCache = [];
  let avataresCache = {}; // { usuarioId: foto } — carregado uma vez, evita foto repetida em cada mensagem do mural
  let conversaAtual = null; // { id, nome, grupo, foto }
  let abaAntesDoChat = 'mural';
  let menuContextoAlvo = null; // { tipo: 'mural'|'privado', id, conversaId, textoAtual }
  let filtroConversaAtual = 'tudo';
  let alvoMenuConversa = null; // conversa selecionada no menu de arquivar

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function iniciais(nome) {
    return nome.trim().split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
  }

  function parseDataServidor(d) {
    if (!d) return null;
    // Se já vem em ISO (contém "T"), usa direto — evita duplicar o "Z"
    // que estava quebrando o parse e gerando "Invalid Date".
    if (typeof d === 'string' && d.includes('T')) return new Date(d);
    return new Date(d.replace(' ', 'T') + 'Z');
  }

  function tempoCurto(d) {
    const dt = parseDataServidor(d);
    if (!dt) return '';
    return dt.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
  }

  function horaMinuto(d) {
    const dt = parseDataServidor(d);
    if (!dt) return '';
    return dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  function dataHoraCompleta(d) {
    const dt = parseDataServidor(d);
    if (!dt) return '';
    return dt.toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function avatarHtml(foto, nome, sizeClass) {
    if (foto) {
      return `<img src="${foto}" alt="${escapeHtml(nome)}" class="${sizeClass} shrink-0 rounded-full object-cover border-2 border-agro-100" />`;
    }
    return `<img src="${FOTO_PADRAO_SVG}" alt="${escapeHtml(nome)}" class="${sizeClass} shrink-0 rounded-full object-cover border-2 border-agro-100" />`;
  }

  async function apiFetch(url, options, mensagemErro) {
    try {
      const resp = await fetch(url, options);
      let data = {};
      try { data = await resp.json(); } catch (_) { data = {}; }
      if (!resp.ok || data.success === false) {
        showCustomAlert('Não foi possível', data.message || mensagemErro || 'Tente novamente em instantes.');
        return null;
      }
      return data;
    } catch (err) {
      console.error(err);
      showCustomAlert('Erro de conexão', 'Não foi possível falar com o servidor. Verifique sua internet e tente novamente.');
      return null;
    }
  }

  async function iniciarConversaCom(id, nomeFallback, fotoFallback) {
    const data = await apiFetch('/painel/conversas/individual', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ usuario_id: id })
    }, 'Não foi possível iniciar essa conversa.');
    if (data && data.success) {
      abrirChat(data.conversa_id, nomeFallback, fotoFallback, false);
    }
  }

  function somenteDigitos(str) {
    return (str || '').replace(/\D/g, '');
  }

  function renderContatosAdminFixos(admins) {
    const container = document.createElement('div');
    admins.forEach((p) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex w-full items-center gap-3 px-5 py-4 text-left transition hover:bg-agro-50 border-b border-slate-100 bg-agro-50/40';
      item.innerHTML = `
        ${avatarHtml(p.foto, p.nome, 'h-14 w-14')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-lg font-bold text-slate-900">${escapeHtml(p.nome)}</span>
          <span class="block text-sm font-bold uppercase tracking-wide text-agro-700">Gestor a</span>
        </span>
      `;
      item.addEventListener('click', () => iniciarConversaCom(p.id, p.nome, p.foto));
      container.appendChild(item);
    });
    return container;
  }

  function renderContatosFiltrados(termo) {
    const container = document.createElement('div');
    const termoDigitos = somenteDigitos(termo);
    if (!termoDigitos) return container;

    const idsComConversaIndividual = new Set(
      conversasCache.filter((c) => !c.grupo && c.participantes[0]).map((c) => c.participantes[0].id)
    );
    const filtrados = contatosCache.filter((p) => p.whatsapp && somenteDigitos(p.whatsapp) === termoDigitos && !idsComConversaIndividual.has(p.id));

    if (!filtrados.length) return container;

    filtrados.forEach((p) => {

      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex w-full items-center gap-3 px-5 py-3 text-left transition hover:bg-slate-50';
      item.innerHTML = `
        ${avatarHtml(p.foto, p.nome, 'h-14 w-14')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-lg font-semibold text-slate-800">${escapeHtml(p.nome)}</span>
         <span class="block text-sm uppercase tracking-wide text-slate-400">${p.tipo_acesso === 'admin' ? 'Gestor a' : 'Produtor a'} · ${escapeHtml(p.whatsapp)}</span>
        </span>
      `;
      item.addEventListener('click', () => iniciarConversaCom(p.id, p.nome, p.foto));
      container.appendChild(item);
    });

    return container;
  }

  function renderListaConversas(termoBusca) {
    listaEl.innerHTML = '';

    const totalNaoLidas = conversasCache.reduce((s, c) => s + (c.arquivada ? 0 : c.nao_lidas), 0);
    if (badge) {
      badge.classList.toggle('hidden', totalNaoLidas === 0);
      badge.textContent = totalNaoLidas;
    }

    const conversasFiltradas = conversasCache.filter((c) => {
      if (filtroConversaAtual === 'arquivadas') return c.arquivada;
      if (c.arquivada) return false;
      if (filtroConversaAtual === 'grupos') return c.grupo;
      return true;
    });

    const termoPreenchido = !!(termoBusca && termoBusca.trim());
    const idsComConversaIndividual = new Set(
      conversasCache.filter((c) => !c.grupo && c.participantes[0]).map((c) => c.participantes[0].id)
    );
    const adminsFixos = filtroConversaAtual === 'tudo'
      ? contatosCache.filter((p) => p.tipo_acesso === 'admin' && !idsComConversaIndividual.has(p.id))
      : [];

    vaziaEl.classList.add('hidden');

    if (conversasFiltradas.length && !termoPreenchido) {
      conversasFiltradas.forEach((c) => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'flex w-full items-center gap-3 px-5 py-4 text-left transition hover:bg-slate-50 border-b border-slate-100';
        item.innerHTML = `
          ${avatarHtml(c.foto, c.nome, 'h-14 w-14')}
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between">
              <span class="truncate text-lg font-bold text-slate-900">${escapeHtml(c.nome)}${c.grupo ? ' (grupo)' : ''}</span>
              <span class="ml-2 shrink-0 text-sm font-semibold text-slate-500">${tempoCurto(c.ultima_mensagem_em)}</span>
            </span>
            <span class="block truncate text-base text-slate-500">${c.ultima_mensagem ? escapeHtml(c.ultima_mensagem) : 'Sem mensagens ainda'}</span>
          </span>
          ${c.nao_lidas > 0 ? `<span class="ml-1 inline-flex h-7 min-w-[1.75rem] shrink-0 items-center justify-center rounded-full bg-agro-600 px-2 text-sm font-bold text-white">${c.nao_lidas}</span>` : ''}
        `;
        item.addEventListener('click', () => abrirChat(c.id, c.nome, c.foto, c.grupo));
        anexarMenuContexto(item, (e, ponto) => abrirMenuConversaContexto(ponto, c));
        listaEl.appendChild(item);
      });
    }

    if (adminsFixos.length) {
      listaEl.appendChild(renderContatosAdminFixos(adminsFixos));
    }

    if (contatosCache.length && filtroConversaAtual === 'tudo' && termoPreenchido) {
      listaEl.appendChild(renderContatosFiltrados(termoBusca));
    }

    if (!conversasFiltradas.length && !adminsFixos.length && !(contatosCache.length && filtroConversaAtual === 'tudo' && termoPreenchido)) {
      vaziaEl.classList.remove('hidden');
    }
  }

    function ativarFiltroConversa(filtro) {
    filtroConversaAtual = filtro;
    estavaEmArquivadas = false;
    document.querySelectorAll('.filtro-conv-btn').forEach((b) => {
      const ativo = b.dataset.filtro === filtro;
      b.classList.toggle('bg-agro-600', ativo);
      b.classList.toggle('text-white', ativo);
      b.classList.toggle('bg-slate-100', !ativo);
      b.classList.toggle('text-slate-600', !ativo);
    });
    renderListaConversas(document.getElementById('buscarContatoInput').value);
  }
  let estavaEmArquivadas = false;

  document.querySelectorAll('.filtro-conv-btn').forEach((btn) => {
    btn.addEventListener('click', () => ativarFiltroConversa(btn.dataset.filtro));
  });
  document.getElementById('btnAbaArquivadas').addEventListener('click', () => abrirTelaArquivadas());
  document.getElementById('btnVoltarArquivadas').addEventListener('click', () => fecharTelaArquivadas());
  ativarFiltroConversa('tudo');

  function abrirTelaArquivadas() {
    estavaEmArquivadas = true;
    document.getElementById('topoConversas').classList.add('hidden');
    document.getElementById('cabecalhoArquivadas').classList.remove('hidden');
    document.getElementById('cabecalhoArquivadas').classList.add('flex');
    filtroConversaAtual = 'arquivadas';
    renderListaConversas('');
  }

  function fecharTelaArquivadas() {
    document.getElementById('cabecalhoArquivadas').classList.add('hidden');
    document.getElementById('cabecalhoArquivadas').classList.remove('flex');
    document.getElementById('topoConversas').classList.remove('hidden');
    ativarFiltroConversa('tudo');
  }

  const menuConversaContexto = document.getElementById('menuConversaContexto');
  const btnMenuFixarConversa = document.getElementById('btnMenuFixarConversa');
  const txtMenuFixarConversa = document.getElementById('txtMenuFixarConversa');
  const btnMenuArquivarConversa = document.getElementById('btnMenuArquivarConversa');
  const txtMenuArquivarConversa = document.getElementById('txtMenuArquivarConversa');
  const btnMenuExcluirConversa = document.getElementById('btnMenuExcluirConversa');

  function abrirMenuConversaContexto(ponto, conversa) {
    alvoMenuConversa = conversa;
   txtMenuFixarConversa.textContent = conversa.fixada ? 'Desafixar' : 'Fixar';
    txtMenuArquivarConversa.textContent = conversa.arquivada ? 'Desarquivar' : 'Arquivar';

    const outroParticipante = conversa.participantes && conversa.participantes[0];
    const conversaComAdmin = !conversa.grupo && outroParticipante && contatosCache.some((p) => p.id === outroParticipante.id && p.tipo_acesso === 'admin');
    btnMenuExcluirConversa.classList.toggle('hidden', conversaComAdmin && !souAdmin);

    const iconFixar = document.getElementById('iconMenuFixar');
    if (iconFixar) {
      iconFixar.setAttribute('fill', conversa.fixada ? 'currentColor' : 'none');
      iconFixar.classList.toggle('text-agro-600', conversa.fixada);
      iconFixar.classList.toggle('text-slate-500', !conversa.fixada);
    }

    const menuLargura = 192;
    const menuAltura = 150;
    let left = ponto.x - menuLargura / 2;
    let top = ponto.y - menuAltura / 2;
    if (left + menuLargura > window.innerWidth - 12) left = window.innerWidth - menuLargura - 12;
    if (left < 12) left = 12;
    if (top + menuAltura > window.innerHeight - 12) top = window.innerHeight - menuAltura - 12;
    if (top < 12) top = 12;

    menuConversaContexto.style.left = left + 'px';
    menuConversaContexto.style.top = top + 'px';
    menuConversaContexto.classList.remove('hidden');
  }


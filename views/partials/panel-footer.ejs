  // Salvar formulário no servidor via PUT
  async function saveProfile(e) {
    e.preventDefault();

    const btn = document.getElementById('btnSaveProfile');
    btn.innerText = 'Salvando...';
    btn.disabled = true;

    const dadosPerfil = {
      nome: document.getElementById('profileNome').value,
      email: document.getElementById('profileEmail').value,
      whatsapp: document.getElementById('profileWhatsapp').value,
      foto: document.getElementById('profileFotoUrl').value
    };

    try {
      const response = await fetch('/painel/perfil', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(dadosPerfil)
      });

      if (response.ok) {
        // Só recarrega a página DEPOIS de confirmar que o servidor salvou
        window.location.reload();
      } else {
        const errData = await response.json().catch(() => ({}));
        showCustomAlert('Erro ao Salvar', errData.message || 'Não foi possível atualizar o perfil no momento. Tente novamente.');
        btn.innerText = 'Salvar Alterações';
        btn.disabled = false;
      }
    } catch (err) {
      console.error(err);
      showCustomAlert('Erro de Conexão', 'Ocorreu uma falha na conexão ao tentar salvar.');
      btn.innerText = 'Salvar Alterações';
      btn.disabled = false;
    }
  }
</script>


    textarea.rows = 1;
    textarea.maxLength = 1000;
    textarea.value = original;
    textarea.style.height = 'auto';
    setTimeout(() => { textarea.style.height = textarea.scrollHeight + 'px'; }, 0);
    textarea.addEventListener('input', () => {
      textarea.style.height = 'auto';
      textarea.style.height = textarea.scrollHeight + 'px';
    });
    // No computador, Enter (sem Shift) salva a edição, como no restante do app.
    textarea.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !ehDispositivoTocavel) {
        e.preventDefault();
        acoes.children[1].click();
      }
    });

    const acoes = document.createElement('div');
    acoes.className = 'mt-2 flex justify-end gap-2';
    acoes.innerHTML = `
      <button type="button" class="rounded-xl bg-white/20 px-3 py-1.5 text-xs font-semibold hover:bg-white/30">Cancelar</button>
      <button type="button" class="rounded-xl bg-white px-3 py-1.5 text-xs font-semibold text-agro-700 hover:bg-slate-100">Salvar</button>
    `;

    bolha.replaceWith(textarea);
    textarea.after(acoes);
    textarea.focus();

    acoes.children[0].addEventListener('click', () => abrirChat(conversaAtual.id, conversaAtual.nome, conversaAtual.foto, conversaAtual.grupo));
    acoes.children[1].addEventListener('click', async () => {
      const novoTexto = textarea.value.trim();

      // Apagou tudo e confirmou (Enter ou botão enviar): pergunta se
      // quer excluir a mensagem, em vez de simplesmente não fazer nada.
      if (!novoTexto) {
        showConfirm('Excluir mensagem?', 'Você apagou todo o texto. Deseja excluir esta mensagem?', async () => {
          const data = await apiFetch(`/painel/conversas/${alvo.conversaId}/mensagens/${alvo.id}/excluir`, { method: 'POST' }, 'Não foi possível excluir a mensagem.');
          if (data && data.success) renderChatMensagens(data.mensagens || []);
        });
        return;
      }

      const data = await apiFetch(`/painel/conversas/${alvo.conversaId}/mensagens/${alvo.id}/editar`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ texto: novoTexto })
      }, 'Não foi possível salvar a edição.');
      if (data && data.success) renderChatMensagens(data.mensagens || []);
    });
  }

  function ativarAbaMsg(aba) {
    document.querySelectorAll('.aba-msg-btn').forEach((b) => {
      const ativo = b.dataset.abaMsg === aba;
      b.classList.toggle('bg-white', ativo);
      b.classList.toggle('text-agro-700', ativo);
      b.classList.toggle('shadow-sm', ativo);
      b.classList.toggle('text-slate-600', !ativo);
    });
    document.getElementById('abaMural').classList.toggle('hidden', aba !== 'mural');
    document.getElementById('abaPrivado').classList.toggle('hidden', aba !== 'privado');
    document.getElementById('abaPrivado').classList.toggle('flex', aba === 'privado');
    abaAntesDoChat = aba;
    if (aba === 'mural') carregarMural();
    if (aba === 'privado') carregarConversas();
  }
  document.querySelectorAll('.aba-msg-btn').forEach((btn) => {
    btn.addEventListener('click', () => ativarAbaMsg(btn.dataset.abaMsg));
  });

  btnAbrir.addEventListener('click', async (e) => {
    e.stopPropagation();
    modalMensagens.classList.remove('hidden');
    mostrarTelaLista();
    await carregarAvataresSeNecessario();
    ativarAbaMsg('mural');
  });
  btnFecharMensagens.addEventListener('click', fecharCentralMensagens);
 modalMensagens.addEventListener('click', (e) => {
    if (e.target === e.currentTarget && pontoDeInicioClique === e.currentTarget) fecharCentralMensagens();
  });
  function fecharCentralMensagens() {
    modalMensagens.classList.add('hidden');
    limparSelecaoMensagem();
    estavaEmArquivadas = false;
    filtroConversaAtual = 'tudo';
  }

  // ---- Alternar entre tela de lista e tela de chat, no mesmo modal ----
   function mostrarTelaLista() {
    limparSelecaoMensagem();
    painelChat.classList.add('hidden');
    cabecalhoChat.classList.add('hidden');
    cabecalhoChat.classList.remove('flex');
    cabecalhoPadrao.classList.remove('hidden');
    abasMensagens.classList.remove('hidden');
    conversaAtual = null;
    if (estavaEmArquivadas) {
      abrirTelaArquivadas();
    } else {
      document.getElementById('cabecalhoArquivadas').classList.add('hidden');
      document.getElementById('cabecalhoArquivadas').classList.remove('flex');
      document.getElementById('topoConversas').classList.remove('hidden');
    }
    ativarAbaMsg(abaAntesDoChat);
  }

  function mostrarTelaChat() {
    cabecalhoPadrao.classList.add('hidden');
    abasMensagens.classList.add('hidden');
    document.getElementById('abaMural').classList.add('hidden');
    document.getElementById('abaPrivado').classList.add('hidden');
    cabecalhoChat.classList.remove('hidden');
    cabecalhoChat.classList.add('flex');
    painelChat.classList.remove('hidden');
    painelChat.classList.add('flex');
  }

  btnVoltarChat.addEventListener('click', () => {
    mostrarTelaLista();
  });

  // ---- Criar grupo ----
  function renderContatos() {
    listaContatosEl.innerHTML = '';

    // Só entra na lista quem já tem uma conversa individual com você
    // (ou seja, você digitou o número dela em algum momento). Quem
    // você excluiu do contato não tem mais conversa no cache, então
    // some daqui automaticamente até você adicioná-la de novo.
    const idsComConversaIndividual = new Set(
      conversasCache.filter((c) => !c.grupo && c.participantes[0]).map((c) => c.participantes[0].id)
    );
    const contatosDisponiveis = contatosCache.filter((p) => idsComConversaIndividual.has(p.id));

    if (!contatosDisponiveis.length) {
      listaContatosEl.innerHTML = `
        <p class="px-2 py-6 text-center text-sm text-slate-400">
          Nenhum contato disponível ainda.<br />Adicione alguém digitando o número dela na busca.
        </p>
      `;
      return;
    }

    contatosDisponiveis.forEach((p) => {
      const linha = document.createElement('label');
      linha.className = 'flex cursor-pointer items-center gap-3 rounded-2xl px-3 py-2.5 transition hover:bg-agro-50 has-[:checked]:bg-agro-50 has-[:checked]:ring-1 has-[:checked]:ring-agro-200';
      linha.innerHTML = `
        <input type="checkbox" name="contatoEscolhido" value="${p.id}" class="h-4 w-4 shrink-0 rounded text-agro-600 focus:ring-agro-500" />
        ${avatarHtml(p.foto, p.nome, 'h-10 w-10')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-slate-800">${escapeHtml(p.nome)}</span>
          <span class="block text-xs uppercase tracking-wide text-slate-400">${p.tipo_acesso === 'admin' ? 'Gestor a' : 'Produtor a'}</span>
        </span>
      `;
      listaContatosEl.appendChild(linha);
    });
  }

  document.getElementById('btnNovaConversa').addEventListener('click', () => {
    modalMensagens.classList.add('hidden');
    nomeGrupoInput.value = '';
    renderContatos();
    modalNova.classList.remove('hidden');
  });

  function fecharModalNova() {
    modalNova.classList.add('hidden');
    modalMensagens.classList.remove('hidden');
  }
  document.getElementById('btnFecharNovaConversa').addEventListener('click', fecharModalNova);
  modalNova.addEventListener('click', (e) => { if (e.target === e.currentTarget && pontoDeInicioClique === e.currentTarget) fecharModalNova(); });

  btnConfirmarGrupo.addEventListener('click', async () => {
    const ids = Array.from(listaContatosEl.querySelectorAll('input:checked')).map((i) => i.value);
    const nome = nomeGrupoInput.value.trim();
    if (!nome || ids.length < 2) {
      showCustomAlert('Faltam informações', 'Dê um nome ao grupo e escolha ao menos 2 pessoas.');
      return;
    }
    btnConfirmarGrupo.disabled = true;
    btnConfirmarGrupo.textContent = 'Criando...';
    try {
      const data = await apiFetch('/painel/conversas/grupo', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome, participantes: ids })
      }, 'Não foi possível criar o grupo.');
      if (data && data.success) {
        modalNova.classList.add('hidden');
        modalMensagens.classList.remove('hidden');
        abrirChat(data.conversa_id, nome, null, true);
      }
    } finally {
      btnConfirmarGrupo.disabled = false;
      btnConfirmarGrupo.textContent = 'Criar grupo';
    }
  });

  // ---- Participantes do grupo ----
  function fecharModalParticipantes() {
    modalParticipantes.classList.add('hidden');
    modalMensagens.classList.remove('hidden');
  }
  document.getElementById('btnFecharParticipantes').addEventListener('click', fecharModalParticipantes);
  modalParticipantes.addEventListener('click', (e) => { if (e.target === e.currentTarget && pontoDeInicioClique === e.currentTarget) fecharModalParticipantes(); });

  async function abrirParticipantes() {
    if (!conversaAtual || !conversaAtual.grupo) return;
     const data = await apiFetch(`/painel/conversas/${conversaAtual.id}/participantes`, undefined, 'Não foi possível carregar os participantes.');
    if (!data) return;
    const participantes = data.participantes || [];
    document.querySelector('#modalParticipantes h3').textContent = `Participantes do grupo (${participantes.length})`;
    listaParticipantesEl.innerHTML = '';
    participantes.forEach((p) => {
      const linha = document.createElement('div');
      linha.className = 'flex items-center gap-3 rounded-2xl px-2 py-2';
      linha.innerHTML = `
        ${avatarHtml(p.foto, p.nome, 'h-11 w-11')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-slate-800">${escapeHtml(p.nome)}${p.id === meuId ? ' (você)' : ''}</span>
          <span class="block text-xs uppercase tracking-wide text-slate-400">${p.tipo_acesso === 'admin' ? 'Gestor a' : 'Produtor a'}</span>
        </span>
      `;
      listaParticipantesEl.appendChild(linha);
    });
    modalMensagens.classList.add('hidden');
    modalParticipantes.classList.remove('hidden');
  }

  chatInfoArea.addEventListener('click', () => {
    if (conversaAtual && conversaAtual.grupo) abrirParticipantes();
  });

  // ---- Foto do grupo ----
  function fecharModalFotoGrupo() {
    modalFotoGrupo.classList.add('hidden');
    modalMensagens.classList.remove('hidden');
  }
  document.getElementById('btnFecharFotoGrupo').addEventListener('click', fecharModalFotoGrupo);
  modalFotoGrupo.addEventListener('click', (e) => { if (e.target === e.currentTarget && pontoDeInicioClique === e.currentTarget) fecharModalFotoGrupo(); });

   chatAvatarButton.addEventListener('click', (e) => {
    e.stopPropagation();
    const ehGrupo = !!(conversaAtual && conversaAtual.grupo);
    btnChatTirarFoto.classList.toggle('hidden', !ehGrupo);
    btnChatCarregarFoto.classList.toggle('hidden', !ehGrupo);
    chatAvatarMenu.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!chatAvatarMenu.classList.contains('hidden') && !chatAvatarMenu.contains(e.target) && !chatAvatarButton.contains(e.target)) {
      chatAvatarMenu.classList.add('hidden');
    }
  });

  btnChatVerFoto.addEventListener('click', () => {
    chatAvatarMenu.classList.add('hidden');
    const fotoAtual = document.querySelector('#chatAvatarWrap img');
    document.getElementById('fullPhotoView').src = fotoAtual ? fotoAtual.src : '';
    document.getElementById('viewPhotoModal').classList.remove('hidden');
  });

  btnChatTirarFoto.addEventListener('click', () => {
    chatAvatarMenu.classList.add('hidden');
    if (!conversaAtual || !conversaAtual.grupo) return;
    capturaFotoAlvo = 'grupo';
    openCameraModal();
  });

  btnChatCarregarFoto.addEventListener('click', () => {
    chatAvatarMenu.classList.add('hidden');
    if (!conversaAtual || !conversaAtual.grupo) return;
    capturaFotoAlvo = 'grupo';
    chatFotoFileInput.click();
  });

  chatFotoFileInput.addEventListener('change', (event) => {
    const file = event.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      showCustomAlert('Arquivo Inválido', 'Por favor, selecione uma imagem válida.');
      return;
    }
    redimensionarImagemBase64(file, (base64Image) => salvarFotoGrupoCapturada(base64Image));
    event.target.value = '';
  });

  async function salvarFotoGrupoCapturada(base64Foto) {
    if (!conversaAtual || !conversaAtual.grupo) return;
    const data = await apiFetch(`/painel/conversas/${conversaAtual.id}/foto`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ foto: base64Foto })
    }, 'Não foi possível salvar a foto do grupo.');
    if (data && data.success) {
      conversaAtual.foto = base64Foto;
      chatAvatarWrap.innerHTML = avatarHtml(base64Foto, conversaAtual.nome, 'h-9 w-9');
    }
  }

  btnSalvarFotoGrupo.addEventListener('click', async () => {
    const foto = inputFotoGrupo.value.trim();
    if (!foto) {
      showCustomAlert('Informe uma foto', 'Cole a URL de uma imagem para o grupo.');
      return;
    }
    btnSalvarFotoGrupo.disabled = true;
    btnSalvarFotoGrupo.textContent = 'Salvando...';
    try {
      const data = await apiFetch(`/painel/conversas/${conversaAtual.id}/foto`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ foto })
      }, 'Não foi possível salvar a foto do grupo.');
      if (data && data.success) {
        conversaAtual.foto = foto;
        chatAvatarWrap.innerHTML = avatarHtml(foto, conversaAtual.nome, 'h-9 w-9');
        fecharModalFotoGrupo();
      }
    } finally {
      btnSalvarFotoGrupo.disabled = false;
      btnSalvarFotoGrupo.textContent = 'Salvar foto';
    }
  });

  // ---- Chat (mesma tela do modal) ----
  const chatMensagens = document.getElementById('chatMensagens');
  let ultimasMensagensChat = [];
  const formEnviar = document.getElementById('formEnviarMensagem');
  const chatInput = document.getElementById('chatInputTexto');

  function renderChatMensagens(mensagens) {
    chatMensagens.innerHTML = mensagens.map((m) => {
      const minha = m.remetente_id === meuId;
      return `
        <div class="flex w-full min-w-0 ${minha ? 'justify-end' : 'justify-start'}" data-msg-id="${m.id}">
          <div class="relative max-w-[75%] min-w-0 rounded-2xl px-5 py-3.5 text-lg leading-relaxed ${minha ? 'bg-agro-500 text-white' : 'bg-slate-100 text-slate-800'}">
            ${!minha ? `<p class="mb-1 text-sm font-bold text-agro-700">${escapeHtml(m.remetente_nome)}</p>` : ''}
            <p class="whitespace-pre-wrap break-words [overflow-wrap:anywhere] bolha-msg" data-msg-texto>${escapeHtml(m.texto)}</p>
            <p class="mt-1 text-right text-xs font-medium ${minha ? 'text-white/70' : 'text-slate-400'}">${horaMinuto(m.criado_em)}${m.editado_em ? ' · editado' : ''}</p>
            <button type="button" class="overlay-selecionar-msg absolute inset-0 rounded-2xl bg-transparent" aria-label="Selecionar mensagem"></button>
          </div>
        </div>
      `;
    }).join('');

    // Guarda a lista atual para a delegação de eventos usar (ver mais
    // abaixo), já que agora os toques são tratados no contêiner, não
    // em cada mensagem individualmente.
    ultimasMensagensChat = mensagens;

    // Sempre mostra a mensagem mais recente (parte de baixo) ao carregar ou enviar.
    chatMensagens.scrollTop = chatMensagens.scrollHeight;
  }

  // Clique simples no botão invisível que cobre a bolha inteira.
  chatMensagens.addEventListener('click', (e) => {
    const overlay = e.target.closest('.overlay-selecionar-msg');
    if (!overlay) return;
    const wrap = overlay.closest('[data-msg-id]');
    if (!wrap) return;
    const id = Number(wrap.dataset.msgId);
    const msg = ultimasMensagensChat.find((m) => m.id === id);
    if (!msg) return;
    alternarSelecaoChat(msg, wrap);
  });

  async function abrirChat(id, titulo, foto, grupo) {
    limparSelecaoMensagem();
    conversaAtual = { id, nome: titulo, foto: foto || null, grupo: !!grupo };
    document.getElementById('chatTitulo').textContent = titulo;
    chatAvatarWrap.innerHTML = avatarHtml(foto, titulo, 'h-9 w-9');
    chatSubtitulo.classList.toggle('hidden', !grupo);
    chatInfoArea.classList.toggle('cursor-pointer', !!grupo);
    mostrarTelaChat();
    const data = await apiFetch('/painel/conversas/' + id + '/mensagens', undefined, 'Não foi possível abrir essa conversa.');
    if (data) renderChatMensagens(data.mensagens || []);
    carregarConversas();
  }

   function ajustarAlturaChatInput() {
    chatInput.style.height = 'auto';
    chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px';
  }
  chatInput.addEventListener('input', ajustarAlturaChatInput);

  // Detecta se o ponteiro principal é "grosso" (touch/celular) ou fino (mouse/computador).
  const ehDispositivoTocavel = window.matchMedia('(pointer: coarse)').matches;

  // No computador: Enter envia e Shift+Enter pula linha.
  // No celular: Enter do teclado sempre pula linha (como no WhatsApp) — só o botão envia.
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !ehDispositivoTocavel) {
      e.preventDefault();
      if (formEnviar.requestSubmit) {
        formEnviar.requestSubmit();
      } else {
        formEnviar.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    }
  });

  formEnviar.addEventListener('submit', async (e) => {
    e.preventDefault();
    const texto = chatInput.value.trim();
    if (!texto || !conversaAtual) return;
    chatInput.value = '';
    ajustarAlturaChatInput();
    const data = await apiFetch('/painel/conversas/' + conversaAtual.id + '/mensagens', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ texto })
    }, 'Não foi possível enviar a mensagem.');
    if (data && data.success) renderChatMensagens(data.mensagens);
  });

  // ---- Sininho de notificações (novos produtos + mensagens não lidas) ----
 async function carregarNotificacoes() {
    const data = await apiFetch('/painel/notificacoes', undefined, 'Não foi possível carregar as notificações.');
    if (!data) return;
    const produtos = data.produtos || [];
    const avisos = data.avisos || [];
    const mensagens = data.mensagens || [];
    const total = produtos.length + avisos.length + mensagens.reduce((s, m) => s + m.nao_lidas, 0);

    badgeNotif.classList.toggle('hidden', total === 0);
    badgeNotif.textContent = total;

    listaNotifEl.innerHTML = '';
    if (!produtos.length && !avisos.length && !mensagens.length) {
      notifVazioEl.classList.remove('hidden');
      return;
    }
    notifVazioEl.classList.add('hidden');

    avisos.forEach((a) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50';
      item.innerHTML = `
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-agro-100 text-agro-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H7l-3 3z"/></svg>
        </span>
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-slate-800">Novo aviso da gestora</span>
          <span class="block truncate text-xs text-slate-500">${escapeHtml(a.texto)}</span>
        </span>
      `;
       item.addEventListener('click', () => {
        apiFetch('/painel/notificacoes/mural/' + a.id + '/ler', { method: 'POST' });
        painelNotif.classList.add('hidden');
        abrirMuralNoAviso(a.id);
      });
      listaNotifEl.appendChild(item);
    });

    produtos.forEach((p) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50';
      item.innerHTML = `
        ${avatarHtml(p.produtor_foto, p.produtor_nome, 'h-10 w-10')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-slate-800">${escapeHtml(p.produtor_nome)} cadastrou um produto</span>
          <span class="block truncate text-xs text-slate-500">${escapeHtml(p.produto_nome)}</span>
        </span>
      `;
      item.addEventListener('click', () => {
        apiFetch('/painel/notificacoes/produtos/' + p.id + '/ler', { method: 'POST' });
        window.location.href = '/painel/produtores?destaque=' + p.produtor_id;
      });
      listaNotifEl.appendChild(item);
    });

    mensagens.forEach((c) => {

    mensagens.forEach((c) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex w-full items-center gap-3 border-b border-slate-100 px-4 py-3 text-left transition hover:bg-slate-50';
      item.innerHTML = `
        ${avatarHtml(c.foto, c.nome, 'h-10 w-10')}
        <span class="min-w-0 flex-1">
          <span class="block truncate text-sm font-semibold text-slate-800">${escapeHtml(c.nome)}</span>
          <span class="block truncate text-xs text-slate-500">${c.ultima_mensagem ? escapeHtml(c.ultima_mensagem) : 'Nova mensagem'}</span>
        </span>
        <span class="inline-flex h-6 min-w-[1.5rem] shrink-0 items-center justify-center rounded-full bg-agro-600 px-1.5 text-xs font-bold text-white">${c.nao_lidas}</span>
      `;
      item.addEventListener('click', () => {
        painelNotif.classList.add('hidden');
        modalMensagens.classList.remove('hidden');
        abrirChat(c.id, c.nome, c.foto, c.grupo);
      });
      listaNotifEl.appendChild(item);
    });
  }

  if (btnNotif) {
    btnNotif.addEventListener('click', async (e) => {
      e.stopPropagation();
      const menuConfigAberto = document.getElementById('menuConfig');
      if (menuConfigAberto) menuConfigAberto.classList.add('hidden');
      const abrindo = painelNotif.classList.contains('hidden');
      painelNotif.classList.toggle('hidden');
      if (abrindo) {
        await carregarNotificacoes();
      }
    });

    document.addEventListener('click', (e) => {
      if (!painelNotif.classList.contains('hidden') && !painelNotif.contains(e.target) && !btnNotif.contains(e.target)) {
        painelNotif.classList.add('hidden');
      }
    });
    carregarNotificacoes();
  }
})();
</script>

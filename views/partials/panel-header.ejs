<div class="min-h-screen bg-slate-50">
  <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="flex w-full items-center justify-between gap-4 px-3 py-3 sm:px-4">

      <!-- ESQUERDA: logo + nome + navegação -->
      <div class="flex items-center gap-6">
        <a href="/painel" class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-agro-100 text-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-700"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
          </div>
          <div class="hidden sm:block leading-tight">
            <p class="text-sm font-bold text-slate-900">Vitrine Agro</p>
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-agro-600">Feira &amp; Produtores</p>
          </div>
        </a>

        <nav class="flex items-center gap-1">
          <a href="/painel" class="rounded-xl px-3 py-2 text-sm font-semibold transition <%= pageTitle === 'Painel de Trabalho' ? 'bg-agro-50 text-agro-700' : 'text-slate-600 hover:bg-slate-100' %>">Painel</a>
          <% if (currentUser.tipo_acesso === 'admin') { %>
          <a href="/painel/produtores" class="rounded-xl px-3 py-2 text-sm font-semibold transition <%= pageTitle === 'Produtores' ? 'bg-agro-50 text-agro-700' : 'text-slate-600 hover:bg-slate-100' %>">Produtores</a>
          <% } else { %>
          <a href="/painel/produtos" class="rounded-xl px-3 py-2 text-sm font-semibold transition <%= pageTitle === 'Meus Produtos' ? 'bg-agro-50 text-agro-700' : 'text-slate-600 hover:bg-slate-100' %>">Produtos</a>
          <% } %>
            <a href="/painel/relatorio" class="rounded-xl px-3 py-2 text-sm font-semibold transition <%= pageTitle === 'Relatórios' ? 'bg-agro-50 text-agro-700' : 'text-slate-600 hover:bg-slate-100' %>">Relatórios</a>
        </nav>
      </div>

      <!-- DIREITA: sino, mensagens, configurações, perfil -->
      <div class="flex items-center gap-2">

        <!-- Sino de notificações -->
        <div class="relative">
          <button type="button" id="btnAbrirNotificacoes" class="relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-slate-200 bg-white text-slate-700 transition hover:border-agro-500 hover:text-agro-700 focus:outline-none focus:ring-2 focus:ring-agro-500" title="Notificações" aria-label="Notificações">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            <span id="badgeNotificacoes" class="hidden absolute -right-1.5 -top-1.5 inline-flex min-h-[1.4rem] min-w-[1.4rem] items-center justify-center rounded-full bg-rose-500 px-1 text-[11px] font-bold text-white"></span>
          </button>
          <div id="painelNotificacoes" class="hidden absolute right-0 top-full z-40 mt-2 w-80 max-h-96 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-xl">
            <div class="border-b border-slate-100 p-3 text-sm font-bold text-slate-900">Notificações</div>
            <div id="listaNotificacoes"></div>
            <div id="notificacoesVazio" class="hidden p-6 text-center text-sm text-slate-400">Nenhuma novidade por aqui.</div>
          </div>
        </div>

        <!-- Mensagens -->
        <button type="button" id="btnAbrirConversas" class="relative inline-flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-slate-200 bg-white text-slate-700 transition hover:border-agro-500 hover:text-agro-700 focus:outline-none focus:ring-2 focus:ring-agro-500" title="Abrir mensagens" aria-label="Abrir mensagens">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span id="badgeConversas" class="hidden absolute -right-1.5 -top-1.5 inline-flex min-h-[1.4rem] min-w-[1.4rem] items-center justify-center rounded-full bg-rose-500 px-1 text-[11px] font-bold text-white"></span>
        </button>

        <!-- Configurações -->
        <div class="relative">
          <button type="button" id="btnAbrirConfig" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border-2 border-slate-200 bg-white text-slate-700 transition hover:border-agro-500 hover:text-agro-700 focus:outline-none focus:ring-2 focus:ring-agro-500" title="Configurações" aria-label="Configurações">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </button>
          <div id="menuConfig" class="hidden absolute right-0 top-full mt-2 w-60 rounded-2xl bg-white p-1.5 shadow-xl border border-slate-200 text-slate-700 text-sm z-40">
            <% if (currentUser.tipo_acesso === 'admin') { %>
            <button type="button" id="btnAbrirCadastrarAdmin" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Cadastrar administrador</span>
            </button>
            <button type="button" id="btnAbrirCadastrarProdutor" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
              <span>Cadastrar produtor</span>
            </button>
           <div class="my-1 border-t border-slate-100"></div>
            <% } %>
            <button type="button" id="btnAbrirAlterarSenha" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-100 transition text-left font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Alterar senha</span>
            </button>
            <div class="my-1 border-t border-slate-100"></div>
            <form action="/logout" method="POST">
              <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-rose-50 transition text-left font-medium text-rose-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span>Sair da conta</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Perfil -->
        <button 
          type="button" 
          onclick="openProfileModal()" 
          class="hidden items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 sm:flex transition hover:border-agro-500 hover:bg-slate-50 text-left focus:outline-none"
          title="Clique para editar seu perfil"
        >
          <img id="headerUserPhoto" src="<%= currentUser.foto || 'data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cdefs%3E%3ClinearGradient id=%27bg%27 x1=%270%27 y1=%270%27 x2=%271%27 y2=%271%27%3E%3Cstop offset=%270%27 stop-color=%27%23d1fae5%27/%3E%3Cstop offset=%271%27 stop-color=%27%23a7f3d0%27/%3E%3C/linearGradient%3E%3C/defs%3E%3Ccircle cx=%2750%27 cy=%2750%27 r=%2750%27 fill=%27url(%23bg)%27/%3E%3Cpath d=%27M50 74V44%27 stroke=%27%23047857%27 stroke-width=%274%27 stroke-linecap=%27round%27/%3E%3Cpath d=%27M50 50c-15-1-24-13-22-27 15 1 24 13 22 27z%27 fill=%27%2310b981%27/%3E%3Cpath d=%27M50 44c15-1 24-13 22-27-15 1-24 13-22 27z%27 fill=%27%2334d399%27/%3E%3Ccircle cx=%2750%27 cy=%2778%27 r=%276%27 fill=%27%23047857%27/%3E%3C/svg%3E' %>" alt="<%= currentUser.nome %>" class="h-9 w-9 rounded-full object-cover border border-emerald-100" />
          <div class="hidden lg:block">
            <p class="text-sm font-semibold text-slate-900"><%= currentUser.nome %></p>
            <p class="text-xs uppercase tracking-[0.14em] text-slate-500"><%= currentUser.tipo_acesso === 'admin' ? 'Gestor a' : 'Produtor a' %></p>
          </div>
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
   <%- include('./notice') %>